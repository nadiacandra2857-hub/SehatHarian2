<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sehatharian.controller.LandingPageController"
            stylesheets="@../css/styles.css"
            prefWidth="1240.0" prefHeight="800.0">

    <!-- A. NAVBAR -->
    <top>
        <HBox styleClass="landing-navbar" spacing="20.0" alignment="CENTER_LEFT">
            <!-- Brand Logo & Name -->
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <ImageView fx:id="brandLogoView" fitWidth="38.0" fitHeight="38.0" preserveRatio="true"/>
                <VBox spacing="1.0">
                    <Label text="SehatHarian" style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #1B3245;"/>
                    <Label text="Kebiasaan Sehat Berkelanjutan" style="-fx-font-size: 10.5px; -fx-text-fill: #2E7D32; -fx-font-weight: 600;"/>
                </VBox>
            </HBox>

            <HBox HBox.hgrow="ALWAYS"/>

            <!-- Center Navigation Links -->
            <HBox spacing="8.0" alignment="CENTER">
                <Button fx:id="btnNavBeranda" text="Beranda" styleClass="landing-nav-link" onAction="#handleNavBeranda"/>
                <Button fx:id="btnNavFitur" text="Fitur Utama" styleClass="landing-nav-link" onAction="#handleNavFitur"/>
                <Button fx:id="btnNavTentang" text="Tentang" styleClass="landing-nav-link" onAction="#handleNavTentang"/>
                <Button fx:id="btnNavBantuan" text="Bantuan" styleClass="landing-nav-link" onAction="#handleNavBantuan"/>
            </HBox>

            <HBox HBox.hgrow="ALWAYS"/>

            <!-- Action Buttons -->
            <HBox spacing="12.0" alignment="CENTER_RIGHT">
                <Button text="Masuk" styleClass="btn-outline" onAction="#handleLogin" prefHeight="38.0" minWidth="90.0"/>
                <Button text="Buat Akun" styleClass="btn-primary" onAction="#handleCreateAccount" prefHeight="38.0" minWidth="120.0"/>
            </HBox>
        </HBox>
    </top>

    <!-- MAIN SCROLLABLE CONTENT -->
    <center>
        <ScrollPane fx:id="mainScrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent;">
            <VBox spacing="0.0">

                <!-- B. HERO SECTION -->
                <VBox fx:id="heroSectionBox" styleClass="landing-hero-container">
                    <HBox spacing="40.0" alignment="CENTER">
                        <!-- Hero Left Content -->
                        <VBox spacing="18.0" HBox.hgrow="ALWAYS" maxWidth="620.0">
                            <HBox spacing="8.0" alignment="CENTER_LEFT">
                                <Label text="PLATFORM KESEHATAN ADAPTIF" styleClass="landing-feature-tag"/>
                                <Label text="•  Riset SKI Kemenkes RI" style="-fx-font-size: 11.5px; -fx-text-fill: #64748B; -fx-font-weight: 500;"/>
                            </HBox>

                            <Label text="Membangun Rutinitas Sehat Harian yang Realistis dan Konsisten."
                                   styleClass="landing-hero-title" wrapText="true"/>

                            <Label text="Bukan perubahan drastis yang sulit dipertahankan. SehatHarian menyusun tantangan mikro harian, rekomendasi nutrisi dan workout adaptif, serta pelacak kebiasaan yang selaras dengan waktu luang Anda."
                                   styleClass="landing-hero-desc" wrapText="true"/>

                            <HBox spacing="16.0" alignment="CENTER_LEFT" style="-fx-padding: 8 0 0 0;">
                                <Button text="Mulai Sekarang — Gratis" styleClass="btn-primary" onAction="#handleCreateAccount" prefHeight="44.0" style="-fx-font-size: 14.5px; -fx-padding: 10 24;"/>
                                <Button text="Sudah Punya Akun? Masuk" styleClass="btn-outline" onAction="#handleLogin" prefHeight="44.0" style="-fx-font-size: 13.5px;"/>
                            </HBox>

                            <HBox spacing="24.0" alignment="CENTER_LEFT" style="-fx-padding: 16 0 0 0;">
                                <HBox spacing="8.0" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-text-fill: #2E7D32; -fx-font-weight: bold;"/>
                                    <Label text="Disesuaikan Waktu Luang" style="-fx-font-size: 12.5px; -fx-text-fill: #475569;"/>
                                </HBox>
                                <HBox spacing="8.0" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-text-fill: #2E7D32; -fx-font-weight: bold;"/>
                                    <Label text="Alarm Tidur Desktop" style="-fx-font-size: 12.5px; -fx-text-fill: #475569;"/>
                                </HBox>
                                <HBox spacing="8.0" alignment="CENTER_LEFT">
                                    <Label text="✓" style="-fx-text-fill: #2E7D32; -fx-font-weight: bold;"/>
                                    <Label text="Grafik Riil Mingguan" style="-fx-font-size: 12.5px; -fx-text-fill: #475569;"/>
                                </HBox>
                            </HBox>
                        </VBox>

                        <!-- Hero Right Image Visual -->
                        <VBox alignment="CENTER" HBox.hgrow="ALWAYS" maxWidth="480.0">
                            <StackPane style="-fx-background-color: #FFFFFF; -fx-background-radius: 20px; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 16, 0, 0, 4); -fx-border-color: #E2E8F0; -fx-border-radius: 20px;">
                                <ImageView fx:id="heroImageView" fitWidth="420.0" fitHeight="280.0" preserveRatio="true"/>
                            </StackPane>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- C. DESKRIPSI PRODUK / PROBLEM & SOLUTION -->
                <VBox fx:id="deskripsiSectionBox" styleClass="landing-section-container" spacing="32.0">
                    <VBox spacing="8.0" alignment="CENTER">
                        <Label text="MENGAPA SEHATHARIAN BERBEDA?" styleClass="landing-feature-tag"/>
                        <Label text="Mengubah Pengetahuan Menjadi Tindakan Nyata" styleClass="landing-section-title"/>
                        <Label text="Banyak orang tahu apa itu hidup sehat, namun kesulitan menerapkannya karena rutinitas yang padat." styleClass="landing-section-subtitle"/>
                    </VBox>

                    <HBox spacing="24.0" alignment="CENTER">
                        <!-- Insight SKI Card -->
                        <VBox spacing="14.0" style="-fx-background-color: #FFFBEB; -fx-border-color: #FDE68A; -fx-border-radius: 14px; -fx-background-radius: 14px; -fx-padding: 24;" HBox.hgrow="ALWAYS">
                            <Label text="Tantangan Gaya Hidup Nyata (SKI 2023)" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #92400E;"/>
                            <Label text="• 37,4% penduduk Indonesia usia ≥ 10 tahun kurang beraktivitas fisik." style="-fx-font-size: 13px; -fx-text-fill: #78350F;"/>
                            <Label text="• Alasan terbanyak: 48,7% tidak punya waktu, dan 32,6% kehilangan motivasi." style="-fx-font-size: 13px; -fx-text-fill: #78350F;"/>
                            <Label text="• 96,7% masyarakat masih kurang asupan serat sayur dan buah harian." style="-fx-font-size: 13px; -fx-text-fill: #78350F;"/>
                        </VBox>

                        <!-- Solution SehatHarian Card -->
                        <VBox spacing="14.0" style="-fx-background-color: #ECFDF5; -fx-border-color: #A7F3D0; -fx-border-radius: 14px; -fx-background-radius: 14px; -fx-padding: 24;" HBox.hgrow="ALWAYS">
                            <Label text="Pendekatan Adaptif SehatHarian" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #065F46;"/>
                            <Label text="• Tantangan mikro realistis: jalan kaki 10-30 menit atau workout rumah ringan." style="-fx-font-size: 13px; -fx-text-fill: #047857;"/>
                            <Label text="• Menyesuaikan waktu luang tanpa membebani jadwal harian Anda." style="-fx-font-size: 13px; -fx-text-fill: #047857;"/>
                            <Label text="• Pemantauan menyeluruh: tidur, hidrasi air putih, aktivitas, dan jadwal makan." style="-fx-font-size: 13px; -fx-text-fill: #047857;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- D. FITUR UTAMA (VARIED COMPOSITION, ANTI-SLOP) -->
                <VBox fx:id="fiturSectionBox" styleClass="landing-section-alt" spacing="36.0">
                    <VBox spacing="8.0" alignment="CENTER">
                        <Label text="FITUR LENGKAP PLATFORM" styleClass="landing-feature-tag"/>
                        <Label text="Semua Alat Penting untuk Tubuh yang Lebih Bugar" styleClass="landing-section-title"/>
                        <Label text="Dirancang secara modular berdasarkan kebutuhan fungsional F-01 sampai F-09 PRD SehatHarian." styleClass="landing-section-subtitle"/>
                    </VBox>

                    <!-- Feature Grid with Varied Cards -->
                    <GridPane hgap="24.0" vgap="24.0" alignment="CENTER">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33.3"/>
                            <ColumnConstraints percentWidth="33.3"/>
                            <ColumnConstraints percentWidth="33.3"/>
                        </columnConstraints>

                        <!-- F-01: Tantangan Harian -->
                        <VBox spacing="12.0" styleClass="landing-feature-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <ImageView fx:id="walkIllustrationView" fitWidth="36.0" fitHeight="36.0" preserveRatio="true"/>
                                <Label text="F-01 • Tantangan Sehat" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
                            </HBox>
                            <Label text="Tantangan Kesehatan Harian" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1B3245;"/>
                            <Label text="Tantangan harian kecil dan realistis. Tandai disarankan, selesai, atau lewati dengan pembaruan status permanen." style="-fx-font-size: 13px; -fx-text-fill: #64748B;" wrapText="true"/>
                        </VBox>

                        <!-- F-02 & F-06: Rekomendasi Adaptif -->
                        <VBox spacing="12.0" styleClass="landing-feature-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <ImageView fx:id="foodIllustrationView" fitWidth="36.0" fitHeight="36.0" preserveRatio="true"/>
                                <Label text="F-02 &amp; F-06 • Rekomendasi" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
                            </HBox>
                            <Label text="Rekomendasi Aktivitas &amp; Menu" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1B3245;"/>
                            <Label text="Filter adaptif berdasarkan durasi waktu luang (5-45+ mnt), lingkungan aktivitas (outdoor/indoor), dan kelompok usia." style="-fx-font-size: 13px; -fx-text-fill: #64748B;" wrapText="true"/>
                        </VBox>

                        <!-- F-03: Pelacak Kebiasaan -->
                        <VBox spacing="12.0" styleClass="landing-feature-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <ImageView fx:id="waterIllustrationView" fitWidth="36.0" fitHeight="36.0" preserveRatio="true"/>
                                <Label text="F-03 • Multi-Tracker" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
                            </HBox>
                            <Label text="Pelacak Kebiasaan Harian" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1B3245;"/>
                            <Label text="Catat asupan air minum (+250ml quick add), menit aktivitas fisik, serta jadwal pola makan sehat dalam satu tempat." style="-fx-font-size: 13px; -fx-text-fill: #64748B;" wrapText="true"/>
                        </VBox>

                        <!-- F-07 & F-08: Jadwal & Alarm Tidur -->
                        <VBox spacing="12.0" styleClass="landing-feature-card" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <ImageView fx:id="sleepIllustrationView" fitWidth="36.0" fitHeight="36.0" preserveRatio="true"/>
                                <Label text="F-07 &amp; F-08 • Tidur &amp; Alarm" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
                            </HBox>
                            <Label text="Jadwal &amp; Pengingat Tidur" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1B3245;"/>
                            <Label text="Input manual jam tidur/bangun lintas tengah malam. Standar ≥ 5 jam, notifikasi 10 menit sebelumnya dan alarm audio." style="-fx-font-size: 13px; -fx-text-fill: #64748B;" wrapText="true"/>
                        </VBox>

                        <!-- F-04: Grafik Konsistensi -->
                        <VBox spacing="12.0" styleClass="landing-feature-card" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Label text="📊" style="-fx-font-size: 20px;"/>
                                <Label text="F-04 • Visualisasi JavaFX" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
                            </HBox>
                            <Label text="Grafik Konsistensi Mingguan" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1B3245;"/>
                            <Label text="Visualisasi grafik batang dan garis 7 hari: skor komposit kebiasaan, tren jam tidur, asupan hidrasi, dan menit aktif." style="-fx-font-size: 13px; -fx-text-fill: #64748B;" wrapText="true"/>
                        </VBox>

                        <!-- F-05: Evaluasi Mingguan -->
                        <VBox spacing="12.0" styleClass="landing-feature-card" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <Label text="🔍" style="-fx-font-size: 20px;"/>
                                <Label text="F-05 • Evaluasi Cerdas" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"/>
                            </HBox>
                            <Label text="Evaluasi &amp; Solusi Mingguan" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1B3245;"/>
                            <Label text="Analisis performa riil 1 minggu terakhir, mendeteksi defisit tidur dan menyajikan rekomendasi pemulihan bertarget." style="-fx-font-size: 13px; -fx-text-fill: #64748B;" wrapText="true"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- E. AJAKAN MENGGUNAKAN APLIKASI (CTA BANNER) -->
                <VBox fx:id="ctaSectionBox" styleClass="landing-section-container" alignment="CENTER">
                    <VBox styleClass="landing-cta-banner" spacing="20.0" alignment="CENTER" maxWidth="960.0">
                        <Label text="MULAI LANGKAH SEHAT ANDA HARI INI" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #86EFAC;"/>
                        <Label text="Siap Membangun Rutinitas Sehat yang Realistis?"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;" textAlignment="CENTER" wrapText="true"/>
                        <Label text="Buat akun dalam 1 menit, selesaikan 3 pertanyaan dasar tentang rutinitas Anda, dan dapatkan tantangan harian yang dirancang khusus."
                               style="-fx-font-size: 14.5px; -fx-text-fill: #CBD5E1;" textAlignment="CENTER" maxWidth="680.0" wrapText="true"/>
                        <HBox spacing="16.0" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                            <Button text="Buat Akun SehatHarian" styleClass="btn-primary" onAction="#handleCreateAccount" prefHeight="44.0" style="-fx-font-size: 14.5px; -fx-padding: 10 28;"/>
                            <Button text="Masuk ke Akun" styleClass="btn-outline" onAction="#handleLogin" prefHeight="44.0" style="-fx-text-fill: #FFFFFF; -fx-border-color: #64748B; -fx-font-size: 13.5px;"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- F. FOOTER -->
                <VBox styleClass="landing-footer" spacing="24.0">
                    <HBox spacing="40.0" alignment="TOP_LEFT">
                        <!-- Col 1: About App -->
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS" maxWidth="380.0">
                            <Label text="SehatHarian" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"/>
                            <Label text="Platform tantangan kesehatan harian adaptif untuk membangun kebiasaan hidup sehat berkelanjutan berbasis JavaFX desktop."
                                   styleClass="landing-footer-link" wrapText="true"/>
                            <Label text="Dibuat untuk Praktikum Pemrograman Berbasis Objek (PBO) 2026."
                                   style="-fx-font-size: 11.5px; -fx-text-fill: #64748B;"/>
                        </VBox>

                        <!-- Col 2: Navigation Links -->
                        <VBox spacing="10.0" minWidth="160.0">
                            <Label text="Navigasi Cepat" styleClass="landing-footer-title"/>
                            <Label text="• Beranda" styleClass="landing-footer-link"/>
                            <Label text="• Fitur Utama" styleClass="landing-footer-link"/>
                            <Label text="• Masuk Akun" styleClass="landing-footer-link"/>
                            <Label text="• Buat Akun Baru" styleClass="landing-footer-link"/>
                        </VBox>

                        <!-- Col 3: Tech Stack -->
                        <VBox spacing="10.0" minWidth="180.0">
                            <Label text="Arsitektur &amp; Teknologi" styleClass="landing-footer-title"/>
                            <Label text="• Java 26 &amp; JavaFX Desktop" styleClass="landing-footer-link"/>
                            <Label text="• FXML &amp; Modern CSS Styling" styleClass="landing-footer-link"/>
                            <Label text="• Gradle Build System" styleClass="landing-footer-link"/>
                            <Label text="• MySQL Server &amp; JDBC" styleClass="landing-footer-link"/>
                        </VBox>

                        <!-- Col 4: Tim Pengembang -->
                        <VBox spacing="10.0" minWidth="240.0">
                            <Label text="Tim Pengembang" styleClass="landing-footer-title"/>
                            <Label text="• Adhitya Ramadhan (3125521047)" styleClass="landing-footer-link"/>
                            <Label text="• Nadia Ayu Candra P. (3125521044)" styleClass="landing-footer-link"/>
                            <Label text="• Muhammad Ai Nur Haaq (3125521052)" styleClass="landing-footer-link"/>
                            <Label text="Dosen: Yunia Ikawati, S.ST, M.Tr.Kom." style="-fx-font-size: 11.5px; -fx-text-fill: #64748B;"/>
                            <Label text="PSDKU Lamongan, Politeknik Elektronika Negeri Surabaya" style="-fx-font-size: 11.5px; -fx-text-fill: #64748B;"/>
                        </VBox>
                    </HBox>

                    <Separator style="-fx-opacity: 0.15;"/>

                    <HBox alignment="CENTER">
                        <Label text="© 2026 SehatHarian. Hak Cipta Dilindungi Undang-Undang." style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>

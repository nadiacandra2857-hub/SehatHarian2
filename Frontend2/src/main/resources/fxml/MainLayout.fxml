<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sehatharian.controller.MainLayoutController"
            prefHeight="780.0" prefWidth="1200.0" stylesheets="@../css/styles.css">

    <!-- SIDEBAR NAVIGASI KIRI (Putih Bersih & Aksen Hijau Sesuai Desain Gambar) -->
    <left>
        <VBox styleClass="sidebar">
            <!-- Brand Logo & Header -->
            <HBox styleClass="sidebar-brand-box" alignment="CENTER_LEFT" spacing="10">
                <ImageView fx:id="brandLogoImageView" fitHeight="34.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true"/>
                <VBox spacing="1">
                    <Label text="SehatHarian" styleClass="brand-title"/>
                    <Label text="Wellness Adaptif 🌿" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>

            <!-- Navigasi Menu Utama Sesuai Gambar -->
            <Label text="MENU UTAMA" styleClass="nav-section-label"/>
            
            <Button fx:id="btnNavDashboard" text="🏠  Beranda" maxWidth="Infinity" styleClass="nav-button, active" onAction="#handleNavDashboard"/>
            <Button fx:id="btnNavTantangan" text="🎯  Tantangan" maxWidth="Infinity" styleClass="nav-button" onAction="#handleNavTantangan"/>
            <Button fx:id="btnNavKebiasaan" text="📝  Kebiasaan" maxWidth="Infinity" styleClass="nav-button" onAction="#handleNavKebiasaan"/>
            <Button fx:id="btnNavRekomendasi" text="💧  Nutrisi &amp; Hidrasi" maxWidth="Infinity" styleClass="nav-button" onAction="#handleNavRekomendasi"/>
            <Button fx:id="btnNavTidur" text="🌙  Tidur" maxWidth="Infinity" styleClass="nav-button" onAction="#handleNavTidur"/>

            <Label text="ANALISIS &amp; EVALUASI" styleClass="nav-section-label"/>
            <Button fx:id="btnNavStatistik" text="📊  Grafik &amp; Evaluasi" maxWidth="Infinity" styleClass="nav-button" onAction="#handleNavStatistik"/>
            <Button fx:id="btnNavEvaluasi" text="📋  Rekap Mingguan" maxWidth="Infinity" styleClass="nav-button" onAction="#handleNavEvaluasi"/>
            <Button fx:id="btnNavProfil" text="👤  Profil" maxWidth="Infinity" styleClass="nav-button" onAction="#handleNavProfil"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- User Status Card di Bawah Sidebar -->
            <VBox styleClass="sidebar-user-card" spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="header-avatar-circle">
                        <Label text="👤" style="-fx-font-size: 14px;"/>
                    </StackPane>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="sidebarUserNameLabel" text="Nadia Ayu Candra" styleClass="sidebar-user-name"/>
                        <Label fx:id="sidebarUserTagLabel" text="Dewasa • Di Luar Rumah" styleClass="sidebar-user-tag"/>
                    </VBox>
                </HBox>
                <Button text="🚪  Keluar ke Beranda" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #DC2626; -fx-font-size: 12px; -fx-font-weight: 600; -fx-cursor: hand; -fx-alignment: CENTER_LEFT; -fx-padding: 4 2;"
                        onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <!-- AREA KONTEN UTAMA KANAN -->
    <center>
        <BorderPane>
            <!-- Top Header Bar Modern Sesuai Gambar -->
            <top>
                <VBox>
                    <HBox styleClass="top-header-bar" alignment="CENTER_LEFT" spacing="20">
                        <!-- Search Bar Sesuai Gambar -->
                        <HBox styleClass="header-search-bar" alignment="CENTER_LEFT" spacing="8">
                            <Label text="🔍" style="-fx-font-size: 13px; -fx-text-fill: #9CA3AF;"/>
                            <TextField promptText="Cari fitur, misalnya: tidur, air, tantangan..." styleClass="header-search-field" HBox.hgrow="ALWAYS"/>
                        </HBox>

                        <VBox spacing="1" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" style="-fx-padding: 0 10;">
                            <Label fx:id="headerTitleLabel" text="Dashboard Kesehatan" styleClass="page-title" style="-fx-font-size: 16px;"/>
                            <Label fx:id="headerSubtitleLabel" text="Selamat datang! Pantau dan bangun kebiasaan sehat hari ini." styleClass="page-subtitle" style="-fx-font-size: 11.5px;"/>
                        </VBox>

                        <!-- Sisi Kanan: Notifikasi & Profil Chip Sesuai Gambar -->
                        <HBox alignment="CENTER" spacing="12">
                            <Label fx:id="headerDateBadgeLabel" text="Minggu, 18 Oktober 2026" styleClass="date-badge"/>
                            <Button text="🔔 Uji Alarm" styleClass="btn-outline" style="-fx-padding: 6 12; -fx-font-size: 12px;" onAction="#handleUjiAlarm"/>
                            
                            <!-- User Profile Chip Sesuai Gambar Top Right -->
                            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="header-user-badge" onMouseClicked="#handleNavProfil">
                                <StackPane styleClass="header-avatar-circle">
                                    <Label text="👩" style="-fx-font-size: 15px;"/>
                                </StackPane>
                                <VBox spacing="1" alignment="CENTER_LEFT">
                                    <Label text="Nadia Ayu Candra" style="-fx-font-size: 12.5px; -fx-font-weight: bold; -fx-text-fill: #E5E7EB;"/>
                                    <Label text="nadiacandra@email.com" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                                </VBox>
                            </HBox>
                        </HBox>
                    </HBox>

                    <!-- Banner Notifikasi Melayang (F-08 & Alerts) -->
                    <HBox fx:id="bannerNotificationBox" styleClass="notification-banner" alignment="CENTER_LEFT" spacing="10" visible="false" managed="false">
                        <Label text="🔔" style="-fx-font-size: 14px;"/>
                        <Label fx:id="bannerNotificationText" text="Pengingat Tidur" styleClass="notification-banner-text" HBox.hgrow="ALWAYS"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Tutup" styleClass="btn-outline" style="-fx-padding: 3 10; -fx-font-size: 11px;" onAction="#handleCloseBanner"/>
                    </HBox>
                </VBox>
            </top>

            <!-- Dynamic View Container -->
            <center>
                <StackPane fx:id="contentArea" style="-fx-background-color: #111827;">
                    <!-- Konten Halaman Aktif Dimuat di Sini Secara Dinamis -->
                </StackPane>
            </center>
        </BorderPane>
    </center>

</BorderPane>

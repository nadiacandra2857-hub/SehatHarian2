<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="main-content-scroll" stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sehatharian.controller.JadwalTidurController">

    <VBox fx:id="tidurRoot" spacing="18" styleClass="content-pane">

        <!-- 1. HEADER SECTION -->
        <HBox styleClass="wellness-card" alignment="CENTER_LEFT" spacing="20">
            <ImageView fx:id="sleepHeaderImageView" fitHeight="90" fitWidth="130" pickOnBounds="true" preserveRatio="true"/>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="🌙 ISTIRAHAT &amp; ALARM DESKTOP (F-07 &amp; F-08)" styleClass="sleep-header-badge"/>
                </HBox>
                <Label text="Jadwal Tidur &amp; Pengingat Istirahat" styleClass="page-title"/>
                <Label text="Standar kesehatan menganjurkan durasi tidur minimal 5 jam setiap malam untuk regenerasi sel tubuh dan kestabilan metabolisme."
                       styleClass="page-subtitle" wrapText="true"/>
            </VBox>
        </HBox>

        <!-- 2. GRID UTAMA: INPUT RECORDING (F-07) & DAEMON CONTROL CENTER (F-08) -->
        <HBox spacing="18" alignment="TOP_LEFT">

            <!-- PANEL KIRI: FORM CATAT JAM TIDUR (F-07) -->
            <VBox spacing="14" styleClass="wellness-card" HBox.hgrow="ALWAYS" minWidth="380">
                <VBox spacing="2">
                    <Label text="Catat Waktu Tidur &amp; Bangun" styleClass="card-title"/>
                    <Label text="Sistem secara otomatis menghitung durasi akurat, termasuk jadwal istirahat lintas tengah malam."
                           styleClass="card-subtitle" wrapText="true"/>
                </VBox>

                <!-- Input Tanggal & Jam -->
                <HBox spacing="12" alignment="TOP_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Tanggal Istirahat:" styleClass="form-label"/>
                        <DatePicker fx:id="datePickerTanggal" prefWidth="160" maxWidth="Infinity"/>
                        <Label text="Tanggal mulai tidur" styleClass="form-hint"/>
                    </VBox>

                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Waktu Masuk Tidur:" styleClass="form-label"/>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <ComboBox fx:id="comboJamTidur" prefWidth="75" onAction="#handleHitungDurasiPreview"/>
                            <Label text=":" style="-fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                            <ComboBox fx:id="comboMenitTidur" prefWidth="75" onAction="#handleHitungDurasiPreview"/>
                        </HBox>
                        <Label text="Format 24 jam" styleClass="form-hint"/>
                    </VBox>

                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Waktu Bangun Pagi:" styleClass="form-label"/>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <ComboBox fx:id="comboJamBangun" prefWidth="75" onAction="#handleHitungDurasiPreview"/>
                            <Label text=":" style="-fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                            <ComboBox fx:id="comboMenitBangun" prefWidth="75" onAction="#handleHitungDurasiPreview"/>
                        </HBox>
                        <Label text="Waktu bangun" styleClass="form-hint"/>
                    </VBox>
                </HBox>

                <!-- Status Lintas Tengah Malam -->
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #F8FAFC; -fx-padding: 8 12; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                    <Label fx:id="labelLintasTengahMalam"
                           text="Jadwal melintasi tengah malam: mulai istirahat malam ini, bangun keesokan harinya."
                           styleClass="sleep-hint-text" wrapText="true"/>
                </HBox>

                <!-- Box Preview Hasil Perhitungan & Standar PRD -->
                <VBox fx:id="boxPreviewDurasi" spacing="8" styleClass="sleep-metric-box">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="1">
                            <Label text="Kalkulasi Durasi Istirahat" styleClass="card-subtitle"/>
                            <Label text="Dihitung secara presisi dalam satuan jam" styleClass="form-hint"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="labelPreviewDurasi" text="7.5 Jam" styleClass="sleep-metric-value"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Kesesuaian Standar Minimal (≥ 5 Jam):" styleClass="card-subtitle"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="badgePreviewStandar" text="Memenuhi Standar Minimal" styleClass="badge-selesai"/>
                    </HBox>

                    <!-- Peringatan evaluasi otomatis jika < 5 jam -->
                    <Label fx:id="labelWarningKurangTidur"
                           text="Perhatian: Durasi tidur di bawah 5 jam memicu evaluasi mingguan otomatis dan menghasilkan rekomendasi pemulihan pada menu Evaluasi."
                           style="-fx-text-fill: #DC2626; -fx-font-size: 11.5px; -fx-font-weight: 600;"
                           visible="false" managed="false" wrapText="true"/>
                </VBox>

                <!-- Checkbox & Tombol Simpan -->
                <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 4 0 0 0;">
                    <CheckBox fx:id="chkAktifkanPengingat" text="Jadikan jadwal ini sebagai acuan alarm desktop" selected="true"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="💾 Simpan Catatan Istirahat" styleClass="btn-primary" onAction="#handleSimpanTidur" style="-fx-padding: 8 18;"/>
                </HBox>
            </VBox>

            <!-- PANEL KANAN: PUSAT KENDALI PENGINGAT & ALARM DESKTOP (F-08) -->
            <VBox spacing="14" styleClass="wellness-card" prefWidth="350" minWidth="280">
                <VBox spacing="2">
                    <Label text="Pusat Kendali Alarm Desktop" styleClass="card-title"/>
                    <Label text="Daemon pengingat bekerja di latar belakang saat aplikasi dibuka atau diminimalkan."
                           styleClass="card-subtitle" wrapText="true"/>
                </VBox>

                <!-- Panel Informasi Jadwal Aktif -->
                <VBox spacing="8" styleClass="sleep-control-panel">
                    <Label text="Jadwal Alarm Aktif:" styleClass="form-label"/>
                    <Label fx:id="labelJadwalAktifInfo" text="Pukul 22:30 WIB" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                    <Label text="Waktu mulai istirahat malam yang dipantau oleh pengingat." styleClass="form-hint" wrapText="true"/>
                </VBox>

                <!-- Stepped Timeline Pengingat -->
                <VBox spacing="8">
                    <Label text="Alur Kerja Pengingat:" styleClass="form-label"/>

                    <VBox spacing="4" styleClass="sleep-timeline-item">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Tahap 1" styleClass="sleep-timeline-step-label"/>
                            <Label text="T-10 Menit Sebelum Tidur" style="-fx-font-weight: 600; -fx-font-size: 12px; -fx-text-fill: #0F172A;"/>
                        </HBox>
                        <Label text="Notifikasi visual desktop muncul di layar sebagai panduan persiapan istirahat."
                               styleClass="sleep-hint-text" wrapText="true"/>
                    </VBox>

                    <VBox spacing="4" styleClass="sleep-timeline-item">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Tahap 2" styleClass="sleep-timeline-step-label"/>
                            <Label text="Waktu Tidur Tiba (Jendela 10 Detik)" style="-fx-font-weight: 600; -fx-font-size: 12px; -fx-text-fill: #0F172A;"/>
                        </HBox>
                        <Label text="Nada harmoni akustik berbunyi lembut memandu Anda segera tidur demi menjaga ritme 5 jam."
                               styleClass="sleep-hint-text" wrapText="true"/>
                    </VBox>
                </VBox>

                <!-- Kontrol Toggle & Tombol Uji -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="btnTogglePengingat" text="Pengingat: Aktif" styleClass="btn-success" onAction="#handleTogglePengingat"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button text="🔔 Uji Suara" styleClass="btn-secondary" onAction="#handleUjiAlarm"/>
                </HBox>

                <Label text="Catatan: Pengingat terus berjalan saat aplikasi diminimalkan dan berhenti bersih saat ditutup."
                       styleClass="form-hint" wrapText="true"/>
            </VBox>

        </HBox>

        <!-- 3. RIWAYAT CATATAN ISTIRAHAT TERSIMPAN DI MYSQL -->
        <VBox styleClass="wellness-card" spacing="12">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="1">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Riwayat Catatan Istirahat" styleClass="card-title"/>
                        <Label fx:id="labelJumlahRiwayat" text="0 Catatan Tersimpan" styleClass="sleep-table-count"/>
                    </HBox>
                    <Label text="Data riil durasi istirahat yang menjadi basis grafik konsistensi mingguan dan evaluasi"
                           styleClass="card-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Perbarui Riwayat" styleClass="btn-outline" onAction="#handleMuatRiwayat"/>
            </HBox>

            <TableView fx:id="tableRiwayatTidur" prefHeight="220" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colTanggal" text="Tanggal Istirahat" prefWidth="130"/>
                    <TableColumn fx:id="colJamTidur" text="Waktu Tidur" prefWidth="100"/>
                    <TableColumn fx:id="colJamBangun" text="Waktu Bangun" prefWidth="100"/>
                    <TableColumn fx:id="colDurasi" text="Durasi (Jam)" prefWidth="110"/>
                    <TableColumn fx:id="colStandar" text="Standar Minimal (≥ 5 Jam)" prefWidth="190"/>
                    <TableColumn fx:id="colPengingat" text="Status Alarm" prefWidth="100"/>
                    <TableColumn fx:id="colAksi" text="Tindakan" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>

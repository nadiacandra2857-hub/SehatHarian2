<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="main-content-scroll" stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sehatharian.controller.DashboardController">

    <VBox fx:id="dashboardRoot" spacing="22" styleClass="content-pane">

        <!-- 1. HERO SECTION -->
        <HBox styleClass="hero-box" alignment="CENTER_LEFT" spacing="24">
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="heroDateLabel" text="Minggu, 18 Oktober 2026" style="-fx-text-fill: #A8D1BF; -fx-font-weight: 600; -fx-font-size: 13px;"/>
                </HBox>
                <Label fx:id="heroGreetingLabel" text="Selamat Pagi, Nadia!" styleClass="hero-greeting"/>
                <Label fx:id="heroQuoteLabel" text="Mulai hari ini dengan satu kebiasaan sehat kecil untuk hasil berkelanjutan." styleClass="hero-quote" wrapText="true"/>
                <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 8 0 0 0;">
                    <Button fx:id="btnHeroAction" text="Kerjakan Tantangan Hari Ini" styleClass="btn-secondary" onAction="#handleBukaTantangan" style="-fx-font-size: 13.5px; -fx-padding: 10 18;"/>
                    <Label fx:id="heroStatusTantanganLabel" text="0 dari 3 tantangan selesai" styleClass="hero-subtext"/>
                </HBox>
            </VBox>
            <ImageView fx:id="heroImageView" fitHeight="150.0" fitWidth="260.0" pickOnBounds="true" preserveRatio="true"/>
        </HBox>

        <!-- 1.5. RINGKASAN PREFERENSI ONBOARDING PENGGUNA -->
        <HBox fx:id="preferenceBannerBox" styleClass="preference-banner-card" alignment="CENTER_LEFT" spacing="16">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="PREFERENSI ONBOARDING ANDA" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1D4ED8;"/>
                    <Label text="• Profil Adaptif" style="-fx-font-size: 11px; -fx-text-fill: #64748B;"/>
                </HBox>
                <Label fx:id="prefPersonalizedNoteLabel" text="Rekomendasi dan tantangan kesehatan harian disesuaikan dengan profil onboarding Anda:"
                       style="-fx-font-size: 12.5px; -fx-text-fill: #334155;"/>
            </VBox>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <HBox spacing="4" alignment="CENTER">
                    <Label text="⏱️ Waktu Luang:" style="-fx-font-size: 11.5px; -fx-text-fill: #475569;"/>
                    <Label fx:id="prefWaktuLuangBadge" text="1 Jam" styleClass="preference-badge-blue"/>
                </HBox>
                <HBox spacing="4" alignment="CENTER">
                    <Label text="🌿 Tempat:" style="-fx-font-size: 11.5px; -fx-text-fill: #475569;"/>
                    <Label fx:id="prefAktivitasBadge" text="Outdoor" styleClass="preference-badge-green"/>
                </HBox>
                <HBox spacing="4" alignment="CENTER">
                    <Label text="👤 Kategori:" style="-fx-font-size: 11.5px; -fx-text-fill: #475569;"/>
                    <Label fx:id="prefKelompokUmurBadge" text="Dewasa" styleClass="preference-badge-amber"/>
                </HBox>
            </HBox>
        </HBox>

        <!-- 2. GRID UTAMA DASHBOARD -->
        <HBox spacing="20">

            <!-- KOLOM KIRI: TANTANGAN HARI INI & REKOMENDASI AKTIF -->
            <VBox spacing="20" HBox.hgrow="ALWAYS" prefWidth="540">

                <!-- Card Tantangan Hari Ini -->
                <VBox styleClass="wellness-card" spacing="16">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="2">
                            <Label text="Tantangan Kesehatan Hari Ini" styleClass="card-title"/>
                            <Label text="Disesuaikan dengan jadwal dan rutinitas Anda" styleClass="card-subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Lihat Semua" styleClass="btn-outline" onAction="#handleBukaTantangan"/>
                    </HBox>

                    <!-- Container Daftar Tantangan Ringkas -->
                    <VBox fx:id="challengesContainer" spacing="12">
                        <!-- Item tantangan dimuat dinamis -->
                    </VBox>
                </VBox>

                <!-- Card Sorotan Rekomendasi -->
                <HBox styleClass="wellness-card" spacing="18" alignment="CENTER_LEFT">
                    <ImageView fx:id="recHighlightImageView" fitHeight="110.0" fitWidth="130.0" pickOnBounds="true" preserveRatio="true"/>
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Rekomendasi Aktivitas Waktu Luang" styleClass="card-title"/>
                        <Label fx:id="recHighlightTitleLabel" text="Peregangan Meja Kerja (Desk Stretch)" style="-fx-font-weight: 600; -fx-font-size: 14px; -fx-text-fill: #2D473B;"/>
                        <Label fx:id="recHighlightDescLabel" text="Luangkan 10 menit di sela aktivitas untuk meredakan ketegangan leher dan bahu." styleClass="card-subtitle" wrapText="true"/>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label fx:id="recHighlightBadge" text="10 Menit • Relaksasi" styleClass="badge-category"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Eksplor Aktivitas" styleClass="btn-primary" onAction="#handleBukaRekomendasi"/>
                        </HBox>
                    </VBox>
                </HBox>

            </VBox>

            <!-- KOLOM KANAN: RINGKASAN LOG KESEHATAN -->
            <VBox spacing="20" prefWidth="380">

                <!-- Ringkasan Hidrasi -->
                <VBox styleClass="wellness-card" spacing="14">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Hidrasi Air Putih" styleClass="card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+250 ml" styleClass="btn-secondary" onAction="#handleQuickAddHydration"/>
                    </HBox>
                    <HBox alignment="BASELINE_LEFT" spacing="8">
                        <Label fx:id="hydrationCurrentLabel" text="1.250" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3B8296;"/>
                        <Label text="/ 2.000 ml target" styleClass="card-subtitle"/>
                    </HBox>
                    <ProgressBar fx:id="hydrationProgressBar" progress="0.62" maxWidth="Infinity" style="-fx-accent: #3B8296;"/>
                    <Label fx:id="hydrationStatusLabel" text="Asupan cairan tubuh sudah 62% tercapai." styleClass="card-subtitle"/>
                </VBox>

                <!-- Ringkasan Aktivitas Fisik -->
                <VBox styleClass="wellness-card" spacing="14">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Aktivitas Fisik Hari Ini" styleClass="card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Catat" styleClass="btn-outline" onAction="#handleBukaKebiasaan"/>
                    </HBox>
                    <HBox alignment="BASELINE_LEFT" spacing="8">
                        <Label fx:id="activityCurrentLabel" text="20" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #3F6354;"/>
                        <Label text="menit bergerak" styleClass="card-subtitle"/>
                    </HBox>
                    <Label fx:id="activitySummaryLabel" text="Aktivitas tercatat: Jalan santai pagi" styleClass="card-subtitle"/>
                </VBox>

                <!-- Ringkasan Tidur Terakhir -->
                <VBox styleClass="wellness-card" spacing="14">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Waktu Tidur Terakhir" styleClass="card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Atur Jadwal" styleClass="btn-outline" onAction="#handleBukaTidur"/>
                    </HBox>
                    <HBox alignment="BASELINE_LEFT" spacing="8">
                        <Label fx:id="sleepDurationLabel" text="7.5" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #5A5EAA;"/>
                        <Label text="jam istirahat" styleClass="card-subtitle"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="sleepStandardBadge" text="Memenuhi Standar (≥ 5 jam)" styleClass="badge-selesai"/>
                    </HBox>
                </VBox>

                <!-- Konsistensi Mingguan Card -->
                <VBox styleClass="wellness-card" spacing="12" style="-fx-background-color: #FAFBF9;">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="2">
                            <Label text="Konsistensi Minggu Ini" styleClass="card-title"/>
                            <Label text="Berdasarkan 7 hari terakhir" styleClass="card-subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="weeklyScoreBadge" text="85%" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2E7D5B;"/>
                    </HBox>
                    <Button text="Lihat Grafik &amp; Evaluasi Lengkap" maxWidth="Infinity" styleClass="btn-primary" onAction="#handleBukaStatistik"/>
                </VBox>

            </VBox>
        </HBox>

    </VBox>
</ScrollPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import com.sehatharian.util.Illustrations?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import com.sehatharian.util.ResponsiveTabs?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import com.sehatharian.util.EditorialImage?>
<?import javafx.scene.layout.HBox?>
<?import com.sehatharian.util.AdaptiveRow?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="main-content-scroll, ui2" stylesheets="@../css/styles.css, @../css/sehat-theme.css, @../css/ui2.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sehatharian.controller.CatatanKebiasaanController" minWidth="0">

    <VBox fx:id="kebiasaanRoot" spacing="18" styleClass="content-pane">

        <!-- Header Panel & Tanggal Pencatatan -->
        <AdaptiveRow styleClass="wellness-card" alignment="CENTER_LEFT" spacing="18">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <AdaptiveRow spacing="8" alignment="CENTER_LEFT">
                    <Label text="CATATAN HARIAN" styleClass="preference-badge-blue" wrapText="true"/>
                </AdaptiveRow>
                <Label text="Kebiasaan harian" styleClass="page-title" wrapText="true"/>
                <Label text="Catat asupan hidrasi air putih, durasi bergerak aktif, dan pola makan bergizi untuk memantau konsistensi Anda." styleClass="page-subtitle" wrapText="true"/>
            </VBox>
            <AdaptiveRow spacing="10" alignment="CENTER_RIGHT">
                <Label text="Tanggal catatan" styleClass="form-label" wrapText="true"/>
                <DatePicker fx:id="datePickerTanggal" onAction="#handleUbahTanggal" prefWidth="160"/>
                <Button text="Hari ini" styleClass="btn-secondary" onAction="#handlePilihHariIni"/>
            </AdaptiveRow>

        </AdaptiveRow>

        <!-- SUB-TABS PELACAK KEBIASAAN -->
        <ResponsiveTabs fx:id="tabPaneKebiasaan" tabClosingPolicy="UNAVAILABLE" styleClass="wellness-card">

            <!-- 1. TAB HIDRASI AIR PUTIH -->
            <Tab text="Minum">
                <VBox spacing="16" style="-fx-padding: 16 4 10 4;">
                    <AdaptiveRow spacing="18" alignment="CENTER_LEFT">
                        <EditorialImage fx:id="waterImageView" quadrant="0"/>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Total Asupan Air Minum Hari terpilih" styleClass="card-subtitle" wrapText="true"/>
                            <AdaptiveRow alignment="BASELINE_LEFT" spacing="8">
                                <Label fx:id="labelTotalHidrasi" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #202121;" wrapText="true"/>
                                <Label text="ml · acuan aplikasi 2.000 ml" styleClass="card-subtitle" wrapText="true"/>
                            </AdaptiveRow>
                            <ProgressBar fx:id="progressBarHidrasi" progress="0.0" maxWidth="Infinity" styleClass="pb-blue"/>
                            <AdaptiveRow fx:id="waterGlassesBox" spacing="6" alignment="CENTER_LEFT"/>
                        </VBox>
                    </AdaptiveRow>

                    <!-- Form Tambah Hidrasi -->
                    <AdaptiveRow spacing="10" alignment="CENTER_LEFT" styleClass="form-panel">
                        <Button text="+250 ml (1 Gelas)" styleClass="btn-secondary, write-command" onAction="#handleQuick250"/>
                        <Button text="+500 ml (Botol)" styleClass="btn-secondary, write-command" onAction="#handleQuick500"/>
                        <Button text="+600 ml" styleClass="btn-secondary, write-command" onAction="#handleQuick600"/>
                    </AdaptiveRow>
                    <AdaptiveRow spacing="10" styleClass="form-panel">
                        <VBox spacing="5" minWidth="0" HBox.hgrow="ALWAYS"><Label text="Jumlah air (ml)" styleClass="form-label"/><TextField fx:id="txtCustomHidrasi" promptText="Jumlah ml (misal 300)" prefWidth="150"/></VBox>
                        <VBox spacing="5" minWidth="0" HBox.hgrow="ALWAYS"><Label text="Catatan (opsional)" styleClass="form-label"/><TextField fx:id="txtCatatanHidrasi" promptText="Catatan (opsional)" prefWidth="180"/></VBox>
                        <Button text="Tambah Air" styleClass="btn-primary, write-command" onAction="#handleTambahHidrasiManual"/>
                    </AdaptiveRow>

                    <!-- Tabel Riwayat Hidrasi Hari Terpilih -->
                    <TableView fx:id="tableHidrasi" prefHeight="200" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colHidrasiJumlah" text="Jumlah Air" prefWidth="150"/>
                            <TableColumn fx:id="colHidrasiCatatan" text="Catatan / Waktu Minum" prefWidth="420"/>
                            <TableColumn fx:id="colHidrasiAksi" text="Aksi" prefWidth="110"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- 2. TAB AKTIVITAS FISIK -->
            <Tab text="Aktivitas">
                <VBox spacing="16" style="-fx-padding: 16 4 10 4;">
                    <AdaptiveRow spacing="18" alignment="CENTER_LEFT">
                        <EditorialImage fx:id="activityImageView" quadrant="3"/>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Total Durasi Aktivitas Hari terpilih" styleClass="card-subtitle" wrapText="true"/>
                            <AdaptiveRow alignment="BASELINE_LEFT" spacing="8">
                                <Label fx:id="labelTotalAktivitas" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #202121;" wrapText="true"/>
                                <Label text="menit aktif bergerak" styleClass="card-subtitle" wrapText="true"/>
                            </AdaptiveRow>
                            <Label fx:id="labelAktivitasStatus" text="Durasi yang Anda catat pada tanggal terpilih." styleClass="card-subtitle" wrapText="true"/>
                        </VBox>
                    </AdaptiveRow>

                    <!-- Form Tambah Aktivitas -->
                    <AdaptiveRow spacing="10" alignment="CENTER_LEFT" styleClass="form-panel">
                        <VBox spacing="5" minWidth="0" HBox.hgrow="ALWAYS"><Label text="Jenis aktivitas" styleClass="form-label"/><ComboBox fx:id="comboPresetAktivitas" promptText="Pilih atau tulis nama aktivitas" prefWidth="200" maxWidth="Infinity"/><Button fx:id="btnKatalogLatihan" text="Jelajahi katalog latihan RepDB" onAction="#handleBukaKatalogLatihan" styleClass="btn-outline" wrapText="true"/></VBox>
                        <VBox spacing="5" minWidth="0" HBox.hgrow="ALWAYS"><Label text="Durasi (menit)" styleClass="form-label"/><TextField fx:id="txtDurasiAktivitas" promptText="Durasi (menit)" prefWidth="110"/></VBox>
                        <VBox spacing="5" minWidth="0" HBox.hgrow="ALWAYS"><Label text="Keterangan (opsional)" styleClass="form-label"/><TextField fx:id="txtKeteranganAktivitas" promptText="Keterangan / Lokasi"/></VBox>
                        <Button text="Simpan Aktivitas" styleClass="btn-primary, write-command" onAction="#handleSimpanAktivitas"/>
                    </AdaptiveRow>

                    <!-- Tabel Aktivitas -->
                    <TableView fx:id="tableAktivitas" prefHeight="200" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colAktivitasJenis" text="Jenis Aktivitas" prefWidth="220"/>
                            <TableColumn fx:id="colAktivitasDurasi" text="Durasi (Menit)" prefWidth="130"/>
                            <TableColumn fx:id="colAktivitasKeterangan" text="Keterangan" prefWidth="320"/>
                            <TableColumn fx:id="colAktivitasAksi" text="Aksi" prefWidth="110"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- 3. TAB POLA & KEBIASAAN MAKAN -->
            <Tab text="Makan">
                <VBox spacing="16" style="-fx-padding: 16 4 10 4;">
                    <AdaptiveRow spacing="18" alignment="CENTER_LEFT">
                        <EditorialImage fx:id="mealImageView" quadrant="1"/>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Pencatatan Kebiasaan Makan Sehat" styleClass="card-title" wrapText="true"/>
                            <Label text="Catat sarapan, makan siang, makan malam, dan camilan untuk membangun pola gizi seimbang dengan cukup sayur, buah, dan protein." styleClass="card-subtitle" wrapText="true"/>
                        </VBox>
                    </AdaptiveRow>

                    <!-- Form Tambah Makanan -->
                    <AdaptiveRow spacing="10" alignment="CENTER_LEFT" styleClass="form-panel">
                        <VBox spacing="5" minWidth="0" HBox.hgrow="ALWAYS"><Label text="Waktu makan" styleClass="form-label"/><ComboBox fx:id="comboWaktuMakan" prefWidth="150"/></VBox>
                        <VBox spacing="5" minWidth="0" HBox.hgrow="ALWAYS"><Label text="Nama menu" styleClass="form-label"/><TextField fx:id="txtNamaMenu" promptText="Nama Menu Makanan / Minuman" prefWidth="260"/></VBox>
                        <VBox spacing="5" minWidth="0" HBox.hgrow="ALWAYS"><Label text="Porsi / keterangan (opsional)" styleClass="form-label"/><TextField fx:id="txtKeteranganMakan" promptText="Keterangan (porsi sayur, buah, dll)"/></VBox>
                        <Button text="Simpan Menu" styleClass="btn-primary, write-command" onAction="#handleSimpanMakan"/>
                    </AdaptiveRow>

                    <!-- Tabel Kebiasaan Makan -->
                    <TableView fx:id="tableMakan" prefHeight="200" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colMakanWaktu" text="Waktu Makan" prefWidth="150"/>
                            <TableColumn fx:id="colMakanMenu" text="Menu Makanan" prefWidth="280"/>
                            <TableColumn fx:id="colMakanKeterangan" text="Keterangan Gizi / Serat" prefWidth="280"/>
                            <TableColumn fx:id="colMakanAksi" text="Aksi" prefWidth="110"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

        </ResponsiveTabs>

    </VBox>
</ScrollPane>

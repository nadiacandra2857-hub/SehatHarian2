<?xml version="1.0" encoding="UTF-8"?>

<?import com.sehatharian.util.Illustrations?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import com.sehatharian.util.AdaptiveRow?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="main-content-scroll, ui2" stylesheets="@../css/styles.css, @../css/sehat-theme.css, @../css/ui2.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sehatharian.controller.TantanganController" minWidth="0">

    <VBox fx:id="tantanganRoot" spacing="18" styleClass="content-pane">

        <!-- Header Panel & Filter Tanggal -->
        <AdaptiveRow styleClass="wellness-card" alignment="CENTER_LEFT" spacing="18">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <AdaptiveRow spacing="8" alignment="CENTER_LEFT">
                    <Label text="TANTANGAN &amp; RIWAYAT" styleClass="preference-badge-green" wrapText="true"/>
                </AdaptiveRow>
                <Label text="Langkah kecil hari ini" styleClass="page-title" wrapText="true"/>
                <Label text="Pilih kategori untuk melihat detail dan status. Gunakan tanggal untuk membuka riwayat." styleClass="page-subtitle" wrapText="true"/>
            </VBox>
            <AdaptiveRow spacing="10" alignment="CENTER_RIGHT">
                <Label text="Tanggal:" styleClass="form-label" wrapText="true"/>
                <DatePicker fx:id="datePickerTanggal" onAction="#handleUbahTanggal" prefWidth="160"/>
                <Button text="Hari Ini" styleClass="btn-secondary" onAction="#handlePilihHariIni"/>
            </AdaptiveRow>

        </AdaptiveRow>

        <!-- Progress Penyelesaian Tantangan Hari Dipilih -->
        <VBox styleClass="wellness-card" spacing="10">
            <AdaptiveRow alignment="CENTER_LEFT">
                <VBox spacing="1">
                    <Label fx:id="labelProgressTitle" text="Kemajuan Tantangan Hari Ini" styleClass="card-title" wrapText="true"/>
                    <Label fx:id="labelProgressSubtitle" text="0 dari 0 tantangan selesai" styleClass="card-subtitle" wrapText="true"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="labelProgressPercent" text="0%" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #202121;" wrapText="true"/>
            </AdaptiveRow>
            <ProgressBar fx:id="progressBarTantangan" progress="0.0" maxWidth="Infinity"/>
        </VBox>

        <!-- Filter Kategori Tantangan -->
        <AdaptiveRow spacing="8" alignment="CENTER_LEFT">
            <Label text="Kategori:" styleClass="form-label" wrapText="true"/>
            <Button fx:id="btnFilterSemua" text="Semua" styleClass="btn-primary" onAction="#handleFilterSemua"/>
            <Button fx:id="btnFilterJalan" text="Jalan Kaki" styleClass="btn-outline" onAction="#handleFilterJalan"/>
            <Button fx:id="btnFilterWorkout" text="Latihan rumah" styleClass="btn-outline" onAction="#handleFilterWorkout"/>
            <Button fx:id="btnFilterPeregangan" text="Peregangan" styleClass="btn-outline" onAction="#handleFilterPeregangan"/>
            <Button fx:id="btnFilterHidrasi" text="Minum &amp; makan" styleClass="btn-outline" onAction="#handleFilterHidrasi"/>
        </AdaptiveRow>

        <!-- Daftar Kartu Tantangan Dinamis -->
        <VBox fx:id="cardsContainer" spacing="12">
            <!-- Kartu tantangan digenerate secara dinamis oleh TantanganController -->
        </VBox>

        <!-- Empty State Container -->
        <VBox fx:id="emptyStateBox" styleClass="empty-state-box" visible="false" managed="false">
            <ImageView fx:id="emptyStateImageView" fitHeight="110" fitWidth="140" pickOnBounds="true" preserveRatio="true"/>
            <Label fx:id="labelEmptyTitle" text="Tidak ada tantangan untuk filter ini." styleClass="empty-state-title" wrapText="true"/>
            <Label fx:id="labelEmptySubtitle" text="Coba ubah filter kategori atau muat ulang tantangan rekomendasi untuk tanggal ini." styleClass="empty-state-subtitle" wrapText="true"/>
            <Button fx:id="btnEmptyAction" text="Muat Tantangan Rekomendasi" styleClass="btn-primary, write-command" onAction="#handleMuatUlangTantangan"/>
        </VBox>

    </VBox>
</ScrollPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane fx:id="mainScrollPane" fitToWidth="true" pannable="true" focusTraversable="true"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="landing-scroll-pane" stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sehatharian.controller.LandingPageController">

    <VBox fx:id="contentVBox" spacing="0.0" alignment="TOP_CENTER" styleClass="landing-page-root">

        <!-- ================================================================ -->
        <!-- 1. HERO SECTION (Real Background Photo + High Contrast Overlay)  -->
        <!-- ================================================================ -->
        <StackPane fx:id="heroStackPane" styleClass="landing-hero-stack">
            <!-- Background Image & Vignette Overlay -->
            <ImageView fx:id="heroBgImageView" preserveRatio="false" smooth="true" mouseTransparent="true" managed="false"/>
            <Region fx:id="heroOverlayRegion" styleClass="hero-gradient-overlay" mouseTransparent="true" managed="false"/>

            <!-- Main Hero Container -->
            <VBox alignment="TOP_CENTER" spacing="28.0" style="-fx-padding: 20 28 44 28;" maxWidth="1260.0" HBox.hgrow="ALWAYS">

                <!-- A. TOP NAVBAR (Floating Glass Capsule) -->
                <HBox alignment="CENTER" spacing="16.0" styleClass="landing-navbar-bar" maxWidth="1240.0" HBox.hgrow="ALWAYS">
                    <!-- Brand Logo Kiri -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="hero-brand-badge" onMouseClicked="#handleNavBeranda">
                        <ImageView fx:id="navbarLogoView" fitWidth="26.0" fitHeight="26.0" preserveRatio="true"/>
                        <VBox spacing="0.0">
                            <Label text="SehatHarian" styleClass="hero-brand-title"/>
                            <Label text="PREVENTIVE HEALTHCARE" styleClass="hero-brand-subtitle"/>
                        </VBox>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Navigasi Capsule Tengah: Deskripsi, Fitur, Downloads, Bantuan -->
                    <HBox styleClass="hero-nav-capsule" spacing="4.0" alignment="CENTER">
                        <Button fx:id="btnNavBeranda" text="Beranda" styleClass="hero-nav-btn, hero-nav-btn-active" onAction="#handleNavBeranda"/>
                        <Button fx:id="btnNavTentang" text="Deskripsi" styleClass="hero-nav-btn" onAction="#handleNavTentang"/>
                        <Button fx:id="btnNavFitur" text="Fitur" styleClass="hero-nav-btn" onAction="#handleNavFitur"/>
                        <Button fx:id="btnNavCoba" text="Downloads" styleClass="hero-nav-btn" onAction="#handleNavCoba"/>
                        <Button fx:id="btnNavBantuan" text="Bantuan" styleClass="hero-nav-btn" onAction="#handleNavBantuan"/>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Tombol Auth Kanan -->
                    <HBox spacing="10.0" alignment="CENTER_RIGHT">
                        <Button fx:id="btnNavLogin" text="Login" styleClass="btn-nav-login" onAction="#handleLogin"/>
                        <Button fx:id="btnNavCreateAccount" text="Create Account" styleClass="btn-nav-create" onAction="#handleCreateAccount"/>
                    </HBox>
                </HBox>

                <!-- B. HERO CENTER BODY (Clear Focus, High Trust) -->
                <VBox fx:id="heroTextContainer" alignment="CENTER" spacing="18.0" maxWidth="940.0" style="-fx-padding: 36 16 28 16;">

                    <!-- Badge Standar Kemenkes RI -->
                    <HBox alignment="CENTER" spacing="8.0" styleClass="hero-pill-badge">
                        <SVGPath content="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zm-2-9l-2-2 1.41-1.41L10 10.17l4.59-4.58L16 7l-6 6z"
                                 styleClass="hero-badge-svg"/>
                        <Label text="STANDAR PREVENTIF GIZI &amp; AKTIVITAS FISIK KEMENKES RI" styleClass="hero-badge-text"/>
                    </HBox>

                    <!-- Judul Utama H1 (Sesuai Wireframe: Realistis Berwarna Hijau) -->
                    <VBox spacing="4.0" alignment="CENTER">
                        <Label text="Membangun Rutinitas Sehat Harian" styleClass="hero-title-main" textAlignment="CENTER" wrapText="true"/>
                        <HBox alignment="CENTER" spacing="8.0">
                            <Label text="yang" styleClass="hero-title-main"/>
                            <Label text="Realistis" styleClass="hero-title-main, hero-title-highlight"/>
                            <Label text="&amp; Konsisten." styleClass="hero-title-main"/>
                        </HBox>
                    </VBox>

                    <!-- Subtitle Deskripsi Singkat -->
                    <Label text="Bukan target ekstrem atau instruksi kaku. SehatHarian mengkalibrasi jadwal hidrasi, gerak mikro, isi piringku, dan waktu tidur berkualitas sesuai lingkungan nyata Anda. Digunakan saat mobilitas tinggi di luar rumah, bekerja dari meja WFH, maupun kenyamanan lansia."
                           styleClass="hero-desc-text" textAlignment="CENTER" wrapText="true" maxWidth="820.0"/>

                    <!-- Action Buttons: Login (Biru Tua) dan Create Account (Hijau Segar) -->
                    <HBox spacing="16.0" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                        <Button fx:id="btnHeroLogin" text="Login" styleClass="btn-hero-login" onAction="#handleLogin" prefHeight="44.0" minWidth="140.0"/>
                        <Button fx:id="btnHeroCreateAccount" text="Create Account" styleClass="btn-hero-create" onAction="#handleCreateAccount" prefHeight="44.0" minWidth="170.0"/>
                        <Button fx:id="btnHeroDemo" text="Coba Simulasi Langsung" styleClass="btn-hero-demo" onAction="#handleNavCoba" prefHeight="44.0"/>
                    </HBox>

                    <!-- Trust Verification Indicators -->
                    <HBox spacing="24.0" alignment="CENTER" style="-fx-padding: 12 0 0 0;">
                        <HBox spacing="6.0" alignment="CENTER">
                            <SVGPath content="M20 6L9 17l-5-5" styleClass="svg-check-emerald"/>
                            <Label text="Bebas Biaya Berlangganan" styleClass="hero-trust-tag"/>
                        </HBox>
                        <HBox spacing="6.0" alignment="CENTER">
                            <SVGPath content="M20 6L9 17l-5-5" styleClass="svg-check-emerald"/>
                            <Label text="Pedoman Gizi Seimbang Kemenkes" styleClass="hero-trust-tag"/>
                        </HBox>
                        <HBox spacing="6.0" alignment="CENTER">
                            <SVGPath content="M20 6L9 17l-5-5" styleClass="svg-check-emerald"/>
                            <Label text="Privasi Data Terenkripsi" styleClass="hero-trust-tag"/>
                        </HBox>
                    </HBox>

                </VBox>
            </VBox>
        </StackPane>

        <!-- ================================================================ -->
        <!-- 2. DESKRIPSI PRODUK (H1 di Kiri + Gambar Shape di Kanan)         -->
        <!-- ================================================================ -->
        <VBox fx:id="deskripsiSectionBox" styleClass="landing-section-white" alignment="CENTER">
            <HBox spacing="44.0" alignment="CENTER" maxWidth="1240.0" HBox.hgrow="ALWAYS">

                <!-- Kolom Kiri: H1 Description & Teks Metodologi -->
                <VBox spacing="16.0" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" maxWidth="640.0">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="DESKRIPSI PRODUK" styleClass="section-tag-pill"/>
                    </HBox>

                    <Label text="Membangun Rutinitas Sehat Harian yang Realistis dan Terukur"
                           styleClass="section-h1-title" wrapText="true"/>

                    <Label text="Mayoritas upaya hidup sehat terhenti di tengah jalan karena target awal dibuat terlalu berat tanpa mempertimbangkan dinamika aktivitas sehari-hari. SehatHarian mengintegrasikan prinsip perubahan perilaku mikro (Atomic Habits) agar Anda dapat konsisten tanpa rasa bersalah."
                           styleClass="section-desc-clean" wrapText="true"/>

                    <!-- 3 Poin Keunggulan Metodologi -->
                    <VBox spacing="14.0" style="-fx-padding: 8 0 0 0;">
                        <HBox spacing="14.0" alignment="TOP_LEFT">
                            <Label text="01" styleClass="step-number-badge"/>
                            <VBox spacing="3.0">
                                <Label text="Pendekatan Tindakan Mikro (Micro-Habits)" styleClass="step-title"/>
                                <Label text="Memulai dari langkah paling mudah: 1 gelas air saat bangun tidur, peregangan 5 menit di sela kerja, dan mematikan layar sebelum tidur."
                                       styleClass="step-desc" wrapText="true"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="14.0" alignment="TOP_LEFT">
                            <Label text="02" styleClass="step-number-badge"/>
                            <VBox spacing="3.0">
                                <Label text="Kalibrasi Waktu Luang &amp; Profil Usia" styleClass="step-title"/>
                                <Label text="Target disesuaikan untuk pelajar, pekerja kantor dengan waktu terbatas, hingga lansia yang memerlukan mobilitas persendian yang aman."
                                       styleClass="step-desc" wrapText="true"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="14.0" alignment="TOP_LEFT">
                            <Label text="03" styleClass="step-number-badge"/>
                            <VBox spacing="3.0">
                                <Label text="Konsistensi Tanpa Beban Psikologis" styleClass="step-title"/>
                                <Label text="Tidak ada reset streak yang membuat putus asa. Platform mendampingi Anda untuk melanjutkan ritme positif di hari berikutnya."
                                       styleClass="step-desc" wrapText="true"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Kolom Kanan: Gambar Shape di samping kanan tulisan H1 -->
                <VBox styleClass="description-shape-card" alignment="CENTER" spacing="12.0" maxWidth="500.0" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="shape-image-wrapper">
                        <ImageView fx:id="aboutImageView" fitWidth="460.0" fitHeight="260.0" preserveRatio="true" smooth="true"/>
                    </StackPane>

                    <!-- Credential Footer di dalam Shape Card -->
                    <VBox spacing="8.0" alignment="CENTER" style="-fx-padding: 4 8 8 8;">
                        <HBox spacing="8.0" alignment="CENTER">
                            <Label text="STANDAR KEMENKES RI" styleClass="shape-badge-green"/>
                            <Label text="TERUKUR &amp; REALISTIS" styleClass="shape-badge-navy"/>
                        </HBox>
                        <Label text="“Panduan gizi seimbang Isi Piringku dan target hidrasi terukur untuk produktivitas prima.”"
                               styleClass="shape-quote-text" textAlignment="CENTER" wrapText="true"/>
                    </VBox>
                </VBox>

            </HBox>
        </VBox>

        <!-- ================================================================ -->
        <!-- 3. STRIP PENILAIAN (Background Biru Tua #0F2C59, 4 Pilar)        -->
        <!-- ================================================================ -->
        <HBox fx:id="penilaianSectionBox" styleClass="penilaian-strip" alignment="CENTER" spacing="32.0" maxWidth="Infinity">
            <!-- Penilaian 1: Hidrasi -->
            <HBox spacing="12.0" alignment="CENTER" HBox.hgrow="ALWAYS">
                <StackPane styleClass="penilaian-icon-bubble">
                    <SVGPath content="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" styleClass="svg-pillar-icon"/>
                </StackPane>
                <VBox spacing="1.0">
                    <Label text="PENILAIAN 01" styleClass="penilaian-number"/>
                    <Label text="Kepatuhan Hidrasi Presisi" styleClass="penilaian-item-title"/>
                    <Label text="Target 2.000 ml / 8 gelas harian" styleClass="penilaian-item-sub"/>
                </VBox>
            </HBox>

            <Separator orientation="VERTICAL" styleClass="penilaian-vertical-divider"/>

            <!-- Penilaian 2: Nutrisi -->
            <HBox spacing="12.0" alignment="CENTER" HBox.hgrow="ALWAYS">
                <StackPane styleClass="penilaian-icon-bubble">
                    <SVGPath content="M12 22a10 10 0 1 0-10-10 10 10 0 0 0 10 10zm0-18a8 8 0 1 1-8 8 8 8 0 0 1 8-8zm0 14a6 6 0 1 0-6-6 6 6 0 0 0 6 6z"
                             styleClass="svg-pillar-icon"/>
                </StackPane>
                <VBox spacing="1.0">
                    <Label text="PENILAIAN 02" styleClass="penilaian-number"/>
                    <Label text="Gizi Seimbang Isi Piringku" styleClass="penilaian-item-title"/>
                    <Label text="Sayur, buah, protein, karbohidrat" styleClass="penilaian-item-sub"/>
                </VBox>
            </HBox>

            <Separator orientation="VERTICAL" styleClass="penilaian-vertical-divider"/>

            <!-- Penilaian 3: Gerak Aktif -->
            <HBox spacing="12.0" alignment="CENTER" HBox.hgrow="ALWAYS">
                <StackPane styleClass="penilaian-icon-bubble">
                    <SVGPath content="M22 12h-4l-3 9L9 3l-3 9H2" styleClass="svg-pillar-icon"/>
                </StackPane>
                <VBox spacing="1.0">
                    <Label text="PENILAIAN 03" styleClass="penilaian-number"/>
                    <Label text="Gerak Mikro Adaptif" styleClass="penilaian-item-title"/>
                    <Label text="15-30 menit latihan tanpa gym" styleClass="penilaian-item-sub"/>
                </VBox>
            </HBox>

            <Separator orientation="VERTICAL" styleClass="penilaian-vertical-divider"/>

            <!-- Penilaian 4: Tidur Sirkadian -->
            <HBox spacing="12.0" alignment="CENTER" HBox.hgrow="ALWAYS">
                <StackPane styleClass="penilaian-icon-bubble">
                    <SVGPath content="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" styleClass="svg-pillar-icon"/>
                </StackPane>
                <VBox spacing="1.0">
                    <Label text="PENILAIAN 04" styleClass="penilaian-number"/>
                    <Label text="Pemulihan Tidur Sirkadian" styleClass="penilaian-item-title"/>
                    <Label text="Pengingat malam &amp; durasi sehat" styleClass="penilaian-item-sub"/>
                </VBox>
            </HBox>
        </HBox>

        <!-- ================================================================ -->
        <!-- 4. FITUR UTAMA PLATFORM SEHAT HARIAN (Interaktif & Bervariasi)   -->
        <!-- ================================================================ -->
        <VBox fx:id="fiturSectionBox" styleClass="landing-section-features" spacing="28.0" alignment="CENTER">

            <!-- Header Section Fitur -->
            <VBox spacing="8.0" alignment="CENTER" maxWidth="820.0">
                <Label text="SISTEM KESEHATAN PREVENTIF TERPADU" styleClass="section-tag-pill"/>
                <HBox alignment="CENTER" spacing="8.0">
                    <Label text="Fitur Utama dalam Platform" styleClass="section-title-navy"/>
                    <Label text="Sehat Harian" styleClass="section-title-emerald"/>
                </HBox>
                <Label text="Setiap fitur dirancang adaptif untuk mendukung kebiasaan sehat harian dengan data yang dapat ditindaklanjuti secara mandiri tanpa membuat semua kartu tampak seragam."
                       styleClass="section-desc-clean" textAlignment="CENTER" wrapText="true"/>
            </VBox>

            <!-- Filter Tab Interaktif -->
            <HBox spacing="10.0" alignment="CENTER">
                <Button fx:id="btnFilterAll" text="Semua Fitur (6)" styleClass="btn-filter-pill, btn-filter-pill-active" onAction="#handleFilterAll"/>
                <Button fx:id="btnFilterHarian" text="Aktivitas &amp; Tantangan" styleClass="btn-filter-pill" onAction="#handleFilterHarian"/>
                <Button fx:id="btnFilterNutrisi" text="Nutrisi &amp; Tidur" styleClass="btn-filter-pill" onAction="#handleFilterNutrisi"/>
                <Button fx:id="btnFilterLaporan" text="Grafik &amp; Evaluasi" styleClass="btn-filter-pill" onAction="#handleFilterLaporan"/>
            </HBox>

            <!-- A. INTERACTIVE LAB SECTION: Checklist Tantangan & Kalkulator -->
            <VBox fx:id="interactiveDemoSectionBox" spacing="20.0" maxWidth="1240.0" HBox.hgrow="ALWAYS">
                <HBox spacing="24.0" alignment="TOP_CENTER">

                    <!-- Fitur 1: Checklist Tantangan Interaktif -->
                    <VBox fx:id="cardFitur1" styleClass="interactive-card" spacing="16.0" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="340.0" onMouseClicked="#handleCardFitur1Click">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <StackPane styleClass="feature-icon-badge-emerald">
                                <SVGPath content="M22 11.08V12a10 10 0 1 1-5.93-9.14 M22 4L12 14.01l-3-3" styleClass="svg-emerald"/>
                            </StackPane>
                            <VBox spacing="1.0">
                                <Label text="SIMULASI INTERAKTIF • FITUR 01" styleClass="feature-kicker-emerald"/>
                                <Label text="Tantangan Kesehatan Harian" styleClass="feature-card-title"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Reset Checklist" styleClass="btn-demo-reset" onAction="#handleResetDemoTantangan"/>
                        </HBox>

                        <Label text="Centang tugas mikro di bawah ini secara langsung untuk merasakan bagaimana aksi kecil membangun ritme harian Anda:"
                               styleClass="interactive-card-subtitle" wrapText="true"/>

                        <!-- Checkboxes Interaktif -->
                        <VBox spacing="10.0" styleClass="interactive-task-container">
                            <CheckBox fx:id="chkDemoTantangan1" text="Minum 2 gelas air putih setelah bangun tidur" styleClass="interactive-checkbox" onAction="#handleUpdateDemoTantangan"/>
                            <CheckBox fx:id="chkDemoTantangan2" text="Jalan santai atau peregangan mikro 15 menit" styleClass="interactive-checkbox" onAction="#handleUpdateDemoTantangan"/>
                            <CheckBox fx:id="chkDemoTantangan3" text="Lengkapi porsi makan siang dengan sayur dan buah" styleClass="interactive-checkbox" onAction="#handleUpdateDemoTantangan"/>
                            <CheckBox fx:id="chkDemoTantangan4" text="Istirahatkan layar gawai 30 menit sebelum tidur" styleClass="interactive-checkbox" onAction="#handleUpdateDemoTantangan"/>
                        </VBox>

                        <!-- Realtime Progress Indicator -->
                        <VBox spacing="6.0">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Progres Capaian:" styleClass="interactive-progress-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblDemoProgressText" text="1 dari 4 Selesai (25%)" styleClass="interactive-progress-percent"/>
                            </HBox>
                            <ProgressBar fx:id="demoProgressBar" progress="0.25" styleClass="feature-progressbar-emerald" maxWidth="Infinity" prefHeight="9.0"/>
                            <Label fx:id="lblDemoCelebration" text="Tantangan harian tuntas! Konsistensi ritme hidup Anda meningkat." styleClass="celebration-label" visible="false" managed="false"/>
                        </VBox>
                    </VBox>

                    <!-- Fitur 3: Kalkulator Metabolisme & Hidrasi Real-time -->
                    <VBox fx:id="cardFitur3" styleClass="interactive-card" spacing="16.0" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="340.0" onMouseClicked="#handleCardFitur3Click">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <StackPane styleClass="feature-icon-badge-blue">
                                <SVGPath content="M4 21v-7 M4 10V3 M12 21v-9 M12 8V3 M20 21v-5 M20 12V3 M1 14h6 M9 8h6 M17 16h6" styleClass="svg-blue"/>
                            </StackPane>
                            <VBox spacing="1.0">
                                <Label text="KALKULATOR METABOLISME • FITUR 03" styleClass="feature-kicker-blue"/>
                                <Label text="Rekomendasi Aktivitas &amp; Hidrasi" styleClass="feature-card-title"/>
                            </VBox>
                        </HBox>

                        <Label text="Geser berat badan Anda untuk melihat formula presisi kebutuhan cairan dan durasi gerak adaptif Kemenkes RI:"
                               styleClass="interactive-card-subtitle" wrapText="true"/>

                        <!-- Slider Berat Badan -->
                        <VBox spacing="8.0" styleClass="slider-container">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Berat Badan Anda:" styleClass="slider-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblBeratBadanVal" text="60 kg" styleClass="slider-value-badge"/>
                            </HBox>
                            <Slider fx:id="sliderBeratBadan" min="40.0" max="110.0" value="60.0" blockIncrement="1.0"
                                    majorTickUnit="20.0" minorTickCount="4" showTickMarks="true" showTickLabels="true"
                                    styleClass="custom-interactive-slider"/>
                        </VBox>

                        <!-- Hasil Kalkulasi 3 Metrik Realtime -->
                        <HBox spacing="10.0" alignment="CENTER">
                            <VBox styleClass="calc-result-box" alignment="CENTER" spacing="3.0" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER" spacing="4.0">
                                    <SVGPath content="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" styleClass="svg-mini-blue"/>
                                    <Label text="Kebutuhan Air" styleClass="calc-result-title"/>
                                </HBox>
                                <Label fx:id="lblKebutuhanAirVal" text="2.100 ml" styleClass="calc-result-val-blue"/>
                                <Label fx:id="lblGelasAirVal" text="≈ 8.4 Gelas / Hari" styleClass="calc-result-sub"/>
                            </VBox>

                            <VBox styleClass="calc-result-box" alignment="CENTER" spacing="3.0" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER" spacing="4.0">
                                    <SVGPath content="M22 12h-4l-3 9L9 3l-3 9H2" styleClass="svg-mini-emerald"/>
                                    <Label text="Target Gerak" styleClass="calc-result-title"/>
                                </HBox>
                                <Label fx:id="lblTargetGerakVal" text="30 Menit" styleClass="calc-result-val-emerald"/>
                                <Label text="Aktivitas Sedang" styleClass="calc-result-sub"/>
                            </VBox>

                            <VBox styleClass="calc-result-box" alignment="CENTER" spacing="3.0" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER" spacing="4.0">
                                    <SVGPath content="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" styleClass="svg-mini-slate"/>
                                    <Label text="Target Tidur" styleClass="calc-result-title"/>
                                </HBox>
                                <Label fx:id="lblTargetTidurVal" text="7.5 Jam" styleClass="calc-result-val-slate"/>
                                <Label text="Ritme Sirkadian" styleClass="calc-result-sub"/>
                            </VBox>
                        </HBox>
                    </VBox>

                </HBox>
            </VBox>

            <!-- B. VARIED FEATURE CARDS (Komposisi Berbeda: Pelacakan, Tidur, Konsistensi, Evaluasi) -->
            <VBox spacing="20.0" maxWidth="1240.0" HBox.hgrow="ALWAYS">
                <HBox spacing="20.0" alignment="TOP_CENTER">

                    <!-- Fitur 2: Pelacakan Kebiasaan (3 Pilar) -->
                    <VBox fx:id="cardFitur2" styleClass="feature-card-clean" spacing="12.0" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="280.0" onMouseClicked="#handleCardFitur2Click">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <StackPane styleClass="feature-icon-badge-blue">
                                <SVGPath content="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" styleClass="svg-blue"/>
                            </StackPane>
                            <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                                <Label text="PENCATATAN RUTIN • FITUR 02" styleClass="feature-kicker-blue"/>
                                <Label text="Pelacakan 3 Pilar Kebiasaan" styleClass="feature-card-title"/>
                            </VBox>
                        </HBox>

                        <Label text="Catat asupan air minum, komposisi gizi 'Isi Piringku', dan menit aktif harian dengan antarmuka cepat sekali klik."
                               styleClass="feature-card-desc" wrapText="true"/>

                        <HBox spacing="8.0" alignment="CENTER" styleClass="feature-preview-widget">
                            <VBox alignment="CENTER" spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label text="8 / 8 Gelas" styleClass="widget-stat-number"/>
                                <Label text="Hidrasi Air" styleClass="widget-stat-caption"/>
                            </VBox>
                            <Separator orientation="VERTICAL"/>
                            <VBox alignment="CENTER" spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label text="Isi Piringku" styleClass="widget-stat-number"/>
                                <Label text="Sayur &amp; Buah" styleClass="widget-stat-caption"/>
                            </VBox>
                            <Separator orientation="VERTICAL"/>
                            <VBox alignment="CENTER" spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label text="35 Menit" styleClass="widget-stat-number"/>
                                <Label text="Gerak Aktif" styleClass="widget-stat-caption"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Fitur 4: Jadwal & Pengingat Tidur -->

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="main-content-scroll" stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sehatharian.controller.JadwalTidurController">

    <VBox fx:id="tidurRoot" spacing="22" styleClass="content-pane">

        <!-- 1. HEADER SECTION: PROPRIETARY WELLNESS BANNER -->
        <HBox styleClass="wellness-card" alignment="CENTER_LEFT" spacing="24">
            <ImageView fx:id="sleepHeaderImageView" fitHeight="105" fitWidth="155" pickOnBounds="true" preserveRatio="true"/>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="PEMANTAUAN ISTIRAHAT &amp; ALARM DESKTOP" styleClass="sleep-header-badge"/>
                </HBox>
                <Label text="Jadwal Tidur &amp; Pengingat Istirahat" styleClass="page-title"/>
                <Label text="Standar kesehatan menganjurkan durasi tidur minimal 5 jam setiap malam untuk regenerasi sel tubuh, kestabilan metabolisme, dan kebugaran optimal."
                       styleClass="page-subtitle" wrapText="true"/>
            </VBox>
        </HBox>

        <!-- 2. GRID UTAMA: INPUT RECORDING (F-07) & DAEMON CONTROL CENTER (F-08) -->
        <HBox spacing="20">

            <!-- PANEL KIRI: FORM CATAT JAM TIDUR (F-07) -->
            <VBox spacing="16" styleClass="wellness-card" HBox.hgrow="ALWAYS" prefWidth="540">
                <VBox spacing="4">
                    <Label text="Catat Waktu Tidur &amp; Bangun" styleClass="card-title"/>
                    <Label text="Sistem secara otomatis menghitung durasi akurat, termasuk jadwal istirahat yang melintasi tengah malam."
                           styleClass="card-subtitle" wrapText="true"/>
                </VBox>

                <!-- Input Tanggal & Jam -->
                <HBox spacing="14" alignment="TOP_LEFT">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Tanggal Istirahat:" styleClass="form-label"/>
                        <DatePicker fx:id="datePickerTanggal" prefWidth="180" maxWidth="Infinity"/>
                        <Label text="Tanggal mulai beristirahat" styleClass="form-hint"/>
                    </VBox>

                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Waktu Masuk Tidur:" styleClass="form-label"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <ComboBox fx:id="comboJamTidur" prefWidth="85" onAction="#handleHitungDurasiPreview"/>
                            <Label text=":" style="-fx-font-weight: bold; -fx-text-fill: #3F6354;"/>
                            <ComboBox fx:id="comboMenitTidur" prefWidth="85" onAction="#handleHitungDurasiPreview"/>
                        </HBox>
                        <Label text="Format 24 jam (JJ : MM)" styleClass="form-hint"/>
                    </VBox>

                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Waktu Bangun Pagi:" styleClass="form-label"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <ComboBox fx:id="comboJamBangun" prefWidth="85" onAction="#handleHitungDurasiPreview"/>
                            <Label text=":" style="-fx-font-weight: bold; -fx-text-fill: #3F6354;"/>
                            <ComboBox fx:id="comboMenitBangun" prefWidth="85" onAction="#handleHitungDurasiPreview"/>
                        </HBox>
                        <Label text="Waktu bangun esok hari" styleClass="form-hint"/>
                    </VBox>
                </HBox>

                <!-- Status Lintas Tengah Malam -->
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #F1F6F3; -fx-padding: 8 14; -fx-background-radius: 8;">
                    <Label fx:id="labelLintasTengahMalam"
                           text="Jadwal melintasi tengah malam: mulai istirahat malam ini, bangun keesokan harinya."
                           styleClass="sleep-hint-text" wrapText="true"/>
                </HBox>

                <!-- Box Preview Hasil Perhitungan & Standar PRD -->
                <VBox fx:id="boxPreviewDurasi" spacing="10" styleClass="sleep-metric-box">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="2">
                            <Label text="Kalkulasi Durasi Istirahat" styleClass="card-subtitle"/>
                            <Label text="Dihitung secara presisi dalam satuan jam" styleClass="form-hint"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="labelPreviewDurasi" text="7.5 Jam" styleClass="sleep-metric-value"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Kesesuaian Standar Minimal (≥ 5 Jam):" styleClass="card-subtitle"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="badgePreviewStandar" text="Memenuhi Standar Minimal" styleClass="badge-selesai"/>
                    </HBox>

                    <!-- Peringatan evaluasi otomatis jika < 5 jam -->
                    <Label fx:id="labelWarningKurangTidur"
                           text="Perhatian: Durasi tidur di bawah 5 jam memicu evaluasi mingguan otomatis dan menghasilkan rekomendasi pemulihan pola hidup pada menu Evaluasi Mingguan."
                           style="-fx-text-fill: #A03415; -fx-font-size: 12px; -fx-line-spacing: 2px;"
                           visible="false" managed="false" wrapText="true"/>
                </VBox>

                <!-- Checkbox & Tombol Simpan -->
                <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 6 0 0 0;">
                    <CheckBox fx:id="chkAktifkanPengingat" text="Jadikan jadwal ini sebagai acuan alarm desktop" selected="true" styleClass="form-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Simpan Catatan Istirahat" styleClass="btn-primary" onAction="#handleSimpanTidur" style="-fx-padding: 10 22;"/>
                </HBox>
            </VBox>

            <!-- PANEL KANAN: PUSAT KENDALI PENGINGAT & ALARM DESKTOP (F-08) -->
            <VBox spacing="16" styleClass="wellness-card" prefWidth="380">
                <VBox spacing="4">
                    <Label text="Pusat Kendali Alarm Desktop" styleClass="card-title"/>
                    <Label text="Daemon pengingat bekerja di latar belakang saat aplikasi dibuka atau diminimalkan."
                           styleClass="card-subtitle" wrapText="true"/>
                </VBox>

                <!-- Panel Informasi Jadwal Aktif -->
                <VBox spacing="10" styleClass="sleep-control-panel">
                    <Label text="Jadwal Alarm Aktif:" styleClass="form-label"/>
                    <Label fx:id="labelJadwalAktifInfo" text="Pukul 22:30 WIB" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E3129;"/>
                    <Label text="Waktu mulai istirahat malam yang dijadikan patokan oleh sistem pengingat." styleClass="form-hint" wrapText="true"/>
                </VBox>

                <!-- Stepped Timeline Pengingat -->
                <VBox spacing="10">
                    <Label text="Alur Kerja Pengingat:" styleClass="form-label"/>

                    <VBox spacing="6" styleClass="sleep-timeline-item">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Tahap 1" styleClass="sleep-timeline-step-label"/>
                            <Label text="T-10 Menit Sebelum Tidur" style="-fx-font-weight: 600; -fx-font-size: 12.5px; -fx-text-fill: #22352C;"/>
                        </HBox>
                        <Label text="Notifikasi visual desktop muncul di layar sebagai panduan persiapan istirahat dan mematikan layar."
                               styleClass="sleep-hint-text" wrapText="true"/>
                    </VBox>

                    <VBox spacing="6" styleClass="sleep-timeline-item">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Tahap 2" styleClass="sleep-timeline-step-label"/>
                            <Label text="Waktu Tidur Tiba (Jendela 10 Detik)" style="-fx-font-weight: 600; -fx-font-size: 12.5px; -fx-text-fill: #22352C;"/>
                        </HBox>
                        <Label text="Nada harmoni akustik berbunyi lembut untuk memandu Anda segera tidur demi menjaga ritme 5 jam."
                               styleClass="sleep-hint-text" wrapText="true"/>
                    </VBox>
                </VBox>

                <!-- Kontrol Toggle & Tombol Uji -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="btnTogglePengingat" text="Pengingat: Aktif" styleClass="btn-success" onAction="#handleTogglePengingat"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-padding: 9 14;"/>
                    <Button text="Uji Suara Alarm" styleClass="btn-secondary" onAction="#handleUjiAlarm" style="-fx-padding: 9 16;"/>
                </HBox>

                <!-- Informasi Latar Belakang -->
                <VBox spacing="4" style="-fx-padding: 4 0 0 0;">
                    <Label text="Catatan Operasional Desktop:" styleClass="form-label"/>
                    <Label text="Pengingat dan alarm terus berjalan saat aplikasi diminimalkan. Proses daemon otomatis dihentikan bersih saat aplikasi ditutup."
                           styleClass="form-hint" wrapText="true"/>
                </VBox>
            </VBox>

        </HBox>

        <!-- 3. RIWAYAT CATATAN ISTIRAHAT TERSIMPAN DI MYSQL -->
        <VBox styleClass="wellness-card" spacing="14">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Riwayat Catatan Istirahat" styleClass="card-title"/>
                        <Label fx:id="labelJumlahRiwayat" text="0 Catatan Tersimpan" styleClass="sleep-table-count"/>
                    </HBox>
                    <Label text="Data riil durasi istirahat yang menjadi basis grafik konsistensi mingguan dan evaluasi pemulihan"
                           styleClass="card-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Perbarui Riwayat" styleClass="btn-outline" onAction="#handleMuatRiwayat"/>
            </HBox>

            <TableView fx:id="tableRiwayatTidur" prefHeight="250" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colTanggal" text="Tanggal Istirahat" prefWidth="140"/>
                    <TableColumn fx:id="colJamTidur" text="Waktu Tidur" prefWidth="110"/>
                    <TableColumn fx:id="colJamBangun" text="Waktu Bangun" prefWidth="110"/>
                    <TableColumn fx:id="colDurasi" text="Durasi (Jam)" prefWidth="120"/>
                    <TableColumn fx:id="colStandar" text="Standar Minimal (≥ 5 Jam)" prefWidth="210"/>
                    <TableColumn fx:id="colPengingat" text="Status Alarm" prefWidth="110"/>
                    <TableColumn fx:id="colAksi" text="Tindakan" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>

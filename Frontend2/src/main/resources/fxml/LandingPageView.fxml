<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane fx:id="mainScrollPane" fitToWidth="true" pannable="true" focusTraversable="true"
            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="landing-scroll-pane" stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sehatharian.controller.LandingPageController">

    <VBox fx:id="contentVBox" spacing="0.0" alignment="TOP_CENTER" styleClass="landing-page-root">

        <!-- ================================================================ -->
        <!-- 1. HERO SPLIT SECTION SESUAI GAMBAR REFERENSI                    -->
        <!-- ================================================================ -->
        <StackPane fx:id="heroStackPane" styleClass="landing-hero-stack">
            <!-- Dynamic Animated Gradient Region -->
            <Region fx:id="heroAnimatedRegion" styleClass="hero-animated-gradient-region" mouseTransparent="true" managed="false"/>

            <!-- Main Hero Container -->
            <VBox alignment="TOP_CENTER" spacing="28.0" style="-fx-padding: 20 36 48 36;" maxWidth="1280.0" HBox.hgrow="ALWAYS">

                <!-- TOP NAVBAR SESUAI GAMBAR -->
                <HBox alignment="CENTER" spacing="16.0" maxWidth="1220.0" HBox.hgrow="ALWAYS">
                    <!-- Brand Logo Kiri: Icon + "SehatHarian" -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="hero-brand-badge" onMouseClicked="#handleNavBeranda">
                        <ImageView fx:id="navbarLogoView" fitWidth="32.0" fitHeight="32.0" preserveRatio="true"/>
                        <Label text="SehatHarian" styleClass="hero-sketch-brand-title"/>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Navigasi Pill Tengah (Kapsul Halus): deskripsi, fitur, downloads, bantuan -->
                    <HBox styleClass="hero-sketch-nav-capsule" spacing="4.0" alignment="CENTER">
                        <Button fx:id="btnNavDeskripsi" text="Deskripsi" styleClass="hero-sketch-nav-btn" onAction="#handleNavDeskripsi"/>
                        <Button fx:id="btnNavFitur" text="Fitur" styleClass="hero-sketch-nav-btn" onAction="#handleNavFitur"/>
                        <Button fx:id="btnNavDownloads" text="Aplikasi" styleClass="hero-sketch-nav-btn" onAction="#handleNavDownloads"/>
                        <Button fx:id="btnNavBantuan" text="Bantuan" styleClass="hero-sketch-nav-btn" onAction="#handleNavBantuan"/>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Auth Quick Action (Kanan) -->
                    <HBox spacing="10.0" alignment="CENTER_RIGHT">
                        <Button fx:id="btnNavLogin" text="Masuk" styleClass="hero-nav-auth-login" onAction="#handleLogin"/>
                        <Button fx:id="btnNavCreateAccount" text="Daftar Sekarang" styleClass="hero-nav-auth-create" onAction="#handleCreateAccount"/>
                    </HBox>
                </HBox>

                <!-- SPLIT HERO: SISI KIRI (HEADLINE + GAMBAR + 3 KARTU) VS SISI KANAN (FORM MASUK) -->
                <HBox spacing="36.0" alignment="CENTER" maxWidth="1220.0" HBox.hgrow="ALWAYS" style="-fx-padding: 10 0 0 0;">

                    <!-- SISI KIRI: Headline & Visualisasi Sesuai Desain Gambar -->
                    <VBox fx:id="heroTextContainer" spacing="18.0" HBox.hgrow="ALWAYS" maxWidth="720.0">
                        <VBox spacing="6.0">
                            <Label text="Langkah Kecil&#10;untuk Hidup Lebih Sehat" styleClass="hero-headline-large" wrapText="true"/>
                            <Label text="Bangun kebiasaan baik, pantau progresnya, dan rasakan perubahan nyata setiap hari."
                                   styleClass="hero-subtitle-green" wrapText="true" maxWidth="600.0"/>
                        </VBox>

                        <!-- Gambar Wellness Sesuai Mockup -->
                        <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-padding: 8 0;">
                            <ImageView fx:id="foto1ImageView" fitHeight="180.0" fitWidth="300.0" preserveRatio="true" smooth="true"/>
                            <VBox spacing="10.0" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                <Label text="🌿 Pendamping Hidup Sehat Adaptif" style="-fx-font-weight: bold; -fx-text-fill: #22C55E; -fx-font-size: 13.5px;"/>
                                <Label text="Disesuaikan dengan waktu luang aktual, pekerjaan kantor maupun WFH, dan kebutuhan hidrasi serta tidur Anda."
                                       styleClass="card-subtitle" wrapText="true"/>
                                <HBox spacing="10.0" style="-fx-padding: 4 0 0 0;">
                                    <Button fx:id="btnHeroLogin" text="Mulai Sekarang" styleClass="btn-primary" onAction="#handleLogin" style="-fx-padding: 8 20;"/>
                                    <Button fx:id="btnHeroCreateAccount" text="Pelajari Fitur ➔" styleClass="btn-outline" onAction="#handleNavFitur" style="-fx-padding: 8 16;"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- 3 KARTU HIGHLIGHT FITUR SESUAI GAMBAR DI BAWAH HERO KIRI -->
                        <HBox spacing="14.0" alignment="CENTER_LEFT">
                            <!-- Card 1: Hijau -->
                            <VBox styleClass="hero-mini-card" spacing="4.0" HBox.hgrow="ALWAYS" onMouseClicked="#handleFeature1Click" style="-fx-cursor: hand;">
                                <HBox alignment="CENTER_LEFT" spacing="6.0">
                                    <Label text="💧" style="-fx-font-size: 16px;"/>
                                    <Label text="Pantau Kebiasaan" styleClass="hero-mini-card-title"/>
                                </HBox>
                                <Label text="Air, tidur, aktivitas dan nutrisi dalam satu tempat" styleClass="hero-mini-card-desc" wrapText="true"/>
                            </VBox>

                            <!-- Card 2: Kuning/Amber -->
                            <VBox styleClass="hero-mini-card" spacing="4.0" HBox.hgrow="ALWAYS" onMouseClicked="#handleFeature2Click" style="-fx-cursor: hand;">
                                <HBox alignment="CENTER_LEFT" spacing="6.0">
                                    <Label text="🎯" style="-fx-font-size: 16px;"/>
                                    <Label text="Tantangan Harian" styleClass="hero-mini-card-title"/>
                                </HBox>
                                <Label text="Mulai dari langkah kecil yang konsisten" styleClass="hero-mini-card-desc" wrapText="true"/>
                            </VBox>

                            <!-- Card 3: Biru -->
                            <VBox styleClass="hero-mini-card" spacing="4.0" HBox.hgrow="ALWAYS" onMouseClicked="#handleFeature3Click" style="-fx-cursor: hand;">
                                <HBox alignment="CENTER_LEFT" spacing="6.0">
                                    <Label text="📊" style="-fx-font-size: 16px;"/>
                                    <Label text="Rekap &amp; Evaluasi" styleClass="hero-mini-card-title"/>
                                </HBox>
                                <Label text="Lihat progres dan capai tujuan kesehatanmu" styleClass="hero-mini-card-desc" wrapText="true"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- SISI KANAN: KARTU MASUK KE AKUN SESUAI GAMBAR PERSIS -->
                    <VBox alignment="CENTER_RIGHT" prefWidth="380.0">
                        <VBox styleClass="hero-login-card-floating" spacing="16.0">
                            <VBox spacing="4.0">
                                <Label text="Masuk ke Akun" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #E5E7EB;"/>
                                <Label text="Selamat datang kembali di SehatHarian" styleClass="card-subtitle" style="-fx-font-size: 12px;"/>
                            </VBox>

                            <!-- Form Fields -->
                            <VBox spacing="12.0">
                                <VBox spacing="4.0">
                                    <Label text="Email" styleClass="form-label"/>
                                    <TextField promptText="contoh@email.com" styleClass="auth-text-field" prefHeight="38.0"/>
                                </VBox>

                                <VBox spacing="4.0">
                                    <Label text="Kata Sandi" styleClass="form-label"/>
                                    <PasswordField promptText="••••••••" styleClass="auth-text-field" prefHeight="38.0"/>
                                </VBox>

                                <HBox alignment="CENTER_LEFT">
                                    <CheckBox text="Ingat saya" selected="true" style="-fx-font-size: 11.5px;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Lupa kata sandi?" style="-fx-background-color: transparent; -fx-text-fill: #06B6D4; -fx-font-size: 11.5px; -fx-font-weight: 600; -fx-padding: 0; -fx-cursor: hand;" onAction="#handleLogin"/>
                                </HBox>

                                <Button text="Masuk" styleClass="btn-primary" maxWidth="Infinity" prefHeight="40.0" onAction="#handleLogin"/>

                                <HBox alignment="CENTER" spacing="8.0">
                                    <Separator HBox.hgrow="ALWAYS"/>
                                    <Label text="atau" style="-fx-text-fill: #9CA3AF; -fx-font-size: 11.5px;"/>
                                    <Separator HBox.hgrow="ALWAYS"/>
                                </HBox>

                                <Button text="G  Masuk dengan Google" styleClass="auth-btn-google" maxWidth="Infinity" prefHeight="38.0" onAction="#handleLogin"/>

                                <HBox alignment="CENTER" spacing="4.0" style="-fx-padding: 6 0 0 0;">
                                    <Label text="Belum punya akun?" style="-fx-font-size: 12px; -fx-text-fill: #9CA3AF;"/>
                                    <Button text="Daftar sekarang" style="-fx-background-color: transparent; -fx-text-fill: #22C55E; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 0; -fx-cursor: hand;" onAction="#handleCreateAccount"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </VBox>

                </HBox>

            </VBox>
        </StackPane>

        <!-- ================================================================ -->
        <!-- 2. SECTION 2: SHOWCASE PREVIEW                                   -->
        <!-- ================================================================ -->
        <VBox fx:id="deskripsiSectionBox" styleClass="section-sketch-showcase" alignment="CENTER">
            <VBox alignment="CENTER" spacing="16.0" maxWidth="1180.0" HBox.hgrow="ALWAYS">
                <VBox styleClass="sketch-photo1-card" alignment="CENTER" spacing="12.0">
                    <Label text="Tampilan Terintegrasi Dashboard &amp; Pelacak Rutinitas Harian" styleClass="card-title" style="-fx-font-size: 16px;"/>
                    <Label text="Satu layar komprehensif memantau konsistensi gerak mikro, asupan cairan tubuh, nutrisi Isi Piringku, dan ritme tidur sirkadian Anda." styleClass="card-subtitle"/>
                </VBox>
            </VBox>
        </VBox>

        <!-- ================================================================ -->
        <!-- 3. GRADIENT TRANSITION BAND 1                                     -->
        <!-- ================================================================ -->
        <Region fx:id="gradientBand1" styleClass="sketch-gradient-band-1" minHeight="48.0" prefHeight="48.0" maxWidth="Infinity"/>

        <!-- ================================================================ -->
        <!-- 4. SECTION 3: FITUR UTAMA DALAM PLATFORM SEHAT HARIAN            -->
        <!-- ================================================================ -->
        <VBox fx:id="fiturSectionBox" styleClass="section-sketch-features" spacing="36.0" alignment="CENTER">

            <!-- Section Title Sesuai Gambar -->
            <VBox spacing="6.0" alignment="CENTER">
                <Label text="Fitur Utama dalam Platform" styleClass="sketch-features-title-blue"/>
                <Label text="Sehat Harian" styleClass="sketch-features-title-green"/>
            </VBox>

            <!-- 4 Cards Side-by-side -->
            <HBox spacing="20.0" alignment="TOP_CENTER" maxWidth="1220.0" HBox.hgrow="ALWAYS">

                <!-- Card 1: Tantangan Harian -->
                <VBox fx:id="cardFitur1" styleClass="sketch-feature-box" spacing="12.0" HBox.hgrow="ALWAYS" maxWidth="290.0" onMouseClicked="#handleFeature1Click">
                    <VBox styleClass="sketch-card-image-wrapper" alignment="CENTER">
                        <ImageView fx:id="foto2ImageView" fitWidth="250.0" preserveRatio="true" smooth="true"/>
                    </VBox>
                    <Label text="GERAK MIKRO • 15-30 MENIT" styleClass="sketch-card-tag"/>
                    <Label text="Tantangan Harian &amp; Gerak Mikro" styleClass="sketch-card-title"/>
                    <Label text="Rekomendasi 15-30 menit aktivitas fisik ringan seperti jalan santai, peregangan otot kantor, dan mobilitas sendi adaptif."
                           styleClass="sketch-card-desc" wrapText="true"/>
                </VBox>

                <!-- Card 2: Pelacakan Hidrasi -->
                <VBox fx:id="cardFitur2" styleClass="sketch-feature-box" spacing="12.0" HBox.hgrow="ALWAYS" maxWidth="290.0" onMouseClicked="#handleFeature2Click">
                    <VBox styleClass="sketch-card-image-wrapper" alignment="CENTER">
                        <ImageView fx:id="foto3ImageView" fitWidth="250.0" preserveRatio="true" smooth="true"/>
                    </VBox>
                    <Label text="HIDRASI PRESISI • 2.000 ML" styleClass="sketch-card-tag"/>
                    <Label text="Pelacakan Hidrasi Presisi" styleClass="sketch-card-title"/>
                    <Label text="Kalibrasi kebutuhan cairan harian berdasarkan berat badan dan intensitas harian (rata-rata 2.000 ml / 8 gelas)."
                           styleClass="sketch-card-desc" wrapText="true"/>
                </VBox>

                <!-- Card 3: Komposisi Porsi Makan -->
                <VBox fx:id="cardFitur3" styleClass="sketch-feature-box" spacing="12.0" HBox.hgrow="ALWAYS" maxWidth="290.0" onMouseClicked="#handleFeature3Click">
                    <VBox styleClass="sketch-card-image-wrapper" alignment="CENTER">
                        <ImageView fx:id="foto4ImageView" fitWidth="250.0" preserveRatio="true" smooth="true"/>
                    </VBox>
                    <Label text="GIZI SEIMBANG • KEMENKES RI" styleClass="sketch-card-tag"/>
                    <Label text="Komposisi Porsi Isi Piringku" styleClass="sketch-card-title"/>
                    <Label text="Panduan visual porsi makan sehat: 1/3 sayuran, 1/3 makanan pokok, 1/6 buah-buahan, dan 1/6 lauk pauk sumber protein."
                           styleClass="sketch-card-desc" wrapText="true"/>
                </VBox>

                <!-- Card 4: Pemulihan Ritme Sirkadian -->
                <VBox fx:id="cardFitur4" styleClass="sketch-feature-box" spacing="12.0" HBox.hgrow="ALWAYS" maxWidth="290.0" onMouseClicked="#handleFeature4Click">
                    <VBox styleClass="sketch-card-image-wrapper" alignment="CENTER">
                        <ImageView fx:id="foto5ImageView" fitWidth="250.0" preserveRatio="true" smooth="true"/>
                    </VBox>
                    <Label text="RITME TIDUR • 7.5 JAM" styleClass="sketch-card-tag"/>
                    <Label text="Pemulihan Ritme Sirkadian" styleClass="sketch-card-title"/>
                    <Label text="Jadwal istirahat malam teratur dengan pengingat tidur bertahap dan evaluasi kualitas istirahat untuk memulihkan kebugaran tubuh."
                           styleClass="sketch-card-desc" wrapText="true"/>
                </VBox>

            </HBox>
        </VBox>

        <!-- ================================================================ -->
        <!-- 5. CTA BAND HIJAU                                                 -->
        <!-- ================================================================ -->
        <StackPane fx:id="downloadSectionBox" styleClass="sketch-gradient-band-2">
            <Region fx:id="gradientBand2" styleClass="hero-animated-gradient-region" mouseTransparent="true" managed="false"/>

            <VBox alignment="CENTER" spacing="14.0" style="-fx-padding: 40 28;" maxWidth="840.0">
                <Label text="Mulai Bangun Rutinitas Sehat Hari Ini" styleClass="sketch-cta-heading"/>
                <Label text="Bergabunglah secara gratis tanpa biaya langganan. Dapatkan kalibrasi kebiasaan harian yang realistis, terukur, dan konsisten."
                       styleClass="sketch-cta-subtext" textAlignment="CENTER" wrapText="true"/>
                <HBox spacing="16.0" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                    <Button text="Buat Akun Sekarang" styleClass="btn-hero-pill-white" onAction="#handleCreateAccount"/>
                    <Button text="Masuk ke Akun" styleClass="btn-hero-pill-dark" onAction="#handleLogin"/>
                </HBox>
            </VBox>
        </StackPane>

        <!-- ================================================================ -->
        <!-- 6. FOOTER RESMI                                                  -->
        <!-- ================================================================ -->
        <VBox fx:id="footerSectionBox" styleClass="sketch-footer-root" spacing="24.0" alignment="CENTER">
            <VBox spacing="20.0" maxWidth="1200.0" HBox.hgrow="ALWAYS">

                <HBox spacing="48.0" alignment="TOP_LEFT">
                    <!-- Kolom 1: Profil SehatHarian & Badges -->
                    <VBox spacing="12.0" HBox.hgrow="ALWAYS" maxWidth="480.0">
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <ImageView fx:id="footerLogoView" fitWidth="26.0" fitHeight="26.0" preserveRatio="true"/>
                            <Label text="SehatHarian" styleClass="sketch-footer-brand-title"/>
                        </HBox>
                        <Label text="Panduan kesehatan dan evaluasi rutinitas harian yang dirancang empatik dan terukur untuk masyarakat dewasa dan lansia di Indonesia."
                               styleClass="sketch-footer-brand-desc" wrapText="true"/>
                        <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 4 0 0 0;">
                            <Label text="Versi 2.4.3-konsisten" styleClass="sketch-footer-version-pill"/>
                            <HBox spacing="6.0" alignment="CENTER_LEFT">
                                <SVGPath content="M20 6L9 17l-5-5" styleClass="sketch-svg-check-green"/>
                                <Label text="Terverifikasi Panduan Gizi Kemenkes" styleClass="sketch-footer-verified-text"/>
                            </HBox>
                        </HBox>
                    </VBox>

                    <!-- Kolom 2: Navigasi Cepat -->
                    <VBox spacing="8.0" minWidth="200.0">
                        <Label text="NAVIGASI CEPAT" styleClass="sketch-footer-col-header"/>
                        <Button text="Fitur Utama" styleClass="sketch-footer-link" onAction="#handleNavFitur"/>
                        <Button text="Tantangan Harian" styleClass="sketch-footer-link" onAction="#handleFeature1Click"/>
                        <Button text="Isi Piringku &amp; Gerak" styleClass="sketch-footer-link" onAction="#handleFeature3Click"/>
                        <Button text="Evaluasi Tidur &amp; Kebiasaan" styleClass="sketch-footer-link" onAction="#handleFeature4Click"/>
                    </VBox>

                    <!-- Kolom 3: Pusat Bantuan & Edukasi -->
                    <VBox spacing="8.0" minWidth="280.0" maxWidth="340.0">
                        <Label text="PUSAT BANTUAN &amp; EDUKASI" styleClass="sketch-footer-col-header"/>
                        <Label text="Layanan konsultasi edukasi dengan dokter dan panduan kesehatan terbit dalam instrumen."
                               styleClass="sketch-footer-brand-desc" wrapText="true"/>
                        <Label text="Senin - Jumat 08:00 - 17:00 WIB" styleClass="sketch-footer-hours"/>
                        <HBox spacing="8.0" alignment="CENTER_LEFT" style="-fx-padding: 2 0 0 0;">
                            <SVGPath content="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zm0 4l8 5 8-5V6l-8 5-8-5v2z"
                                     styleClass="sketch-svg-mail-blue"/>
                            <Label text="bantuan@sehatharian.id" styleClass="sketch-footer-email-link" onMouseClicked="#handleContactEmail"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Separator styleClass="sketch-footer-separator"/>

                <HBox alignment="CENTER_LEFT">
                    <Label text="© 2026 SehatHarian Indonesia. Seluruh hak cipta dilindungi undang-undang."
                           styleClass="sketch-footer-copyright"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox spacing="16.0" alignment="CENTER_RIGHT">
                        <Button text="Kebijakan Privasi" styleClass="sketch-footer-link" onAction="#handleFooterPrivacy"/>
                        <Label text="•" styleClass="sketch-footer-bullet"/>
                        <Button text="Syarat Ketentuan" styleClass="sketch-footer-link" onAction="#handleFooterTerms"/>
                    </HBox>
                </HBox>

                <HBox alignment="CENTER">
                    <VBox styleClass="sketch-medical-disclaimer-pill" alignment="CENTER" HBox.hgrow="ALWAYS">
                        <Label text="Penyangkalan Medis: Informasi dan panduan di SehatHarian ditujukan untuk edukasi gaya hidup mandiri dan tidak menggantikan diagnosis, pemeriksaan, atau intervensi medis resmi oleh tenaga kesehatan profesional."
                               styleClass="sketch-disclaimer-text" textAlignment="CENTER" wrapText="true"/>
                    </VBox>
                </HBox>

            </VBox>
        </VBox>

    </VBox>
</ScrollPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sehatharian.controller.MainLayoutController"
            prefHeight="760.0" prefWidth="1180.0" stylesheets="@../css/styles.css, @../css/sehat-theme.css, @../css/dashboard.css, @../css/ui2.css">

    <!-- SIDEBAR NAVIGASI KIRI -->
    <left>
        <ScrollPane fx:id="sidebarScroll" fitToWidth="true" hbarPolicy="NEVER" prefWidth="248" minWidth="72" styleClass="sidebar-scroll">
        <content>
        <VBox fx:id="sidebarRoot" styleClass="sidebar">
            <!-- Brand Logo & Header -->
            <HBox styleClass="sidebar-brand-box" alignment="CENTER_LEFT">
                <ImageView fx:id="brandLogoImageView" fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true"/>
                <VBox fx:id="brandTextBox" spacing="1">
                    <Label text="SehatHarian" styleClass="brand-title"/>
                    <Label fx:id="brandSubtitleLabel" text="Wellness harian" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>

            <!-- Navigasi Menu Utama -->
            <Label fx:id="navSectionMenu" text="MENU UTAMA" styleClass="nav-section-label"/>
            
            <Button fx:id="btnNavDashboard" text="Beranda" maxWidth="Infinity" styleClass="nav-button, active" onAction="#handleNavDashboard"/>
            <Button fx:id="btnNavTantangan" text="Tantangan Harian" maxWidth="Infinity" styleClass="nav-button" onAction="#handleNavTantangan"/>
            <Button fx:id="btnNavRekomendasi" text="Rekomendasi Aktivitas" maxWidth="Infinity" styleClass="nav-button" onAction="#handleNavRekomendasi"/>
            <Button fx:id="btnNavKebiasaan" text="Catatan Kebiasaan" maxWidth="Infinity" styleClass="nav-button" onAction="#handleNavKebiasaan"/>
            <Button fx:id="btnNavTidur" text="Jadwal &amp; Alarm Tidur" maxWidth="Infinity" styleClass="nav-button" onAction="#handleNavTidur"/>

            <Label fx:id="navSectionAnalisis" text="ANALISIS &amp; LAPORAN" styleClass="nav-section-label"/>
            <Button fx:id="btnNavStatistik" text="Statistik Mingguan" maxWidth="Infinity" styleClass="nav-button" onAction="#handleNavStatistik"/>
            <Button fx:id="btnNavEvaluasi" text="Evaluasi Mingguan" maxWidth="Infinity" styleClass="nav-button" onAction="#handleNavEvaluasi"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- User Status Card di Bawah Sidebar -->
            <VBox fx:id="sidebarUserCard" styleClass="sidebar-user-card" spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="avatar-circle">
                        <Label fx:id="sidebarAvatarLabel" text="SH" styleClass="avatar-initials"/>
                    </StackPane>
                    <VBox fx:id="sidebarUserTextBox" spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="sidebarUserNameLabel" text="Nadia Ayu Candra" styleClass="sidebar-user-name"/>
                        <Label fx:id="sidebarUserTagLabel" text="Dewasa • Di Luar Rumah" styleClass="sidebar-user-tag"/>
                    </VBox>
                </HBox>
                <Button fx:id="btnNavProfil" text="Profil" styleClass="btn-secondary" maxWidth="Infinity" minHeight="44" accessibleText="Buka profil pengguna" style="-fx-font-size: 12px;" onAction="#handleNavProfil"/>
                <Button fx:id="btnLogout" text="Keluar ke Beranda" minHeight="44" accessibleText="Keluar dari akun ini" maxWidth="Infinity" styleClass="sidebar-link-btn"
                        onAction="#handleLogout"/>
            </VBox>
        </VBox>
            </content>
        </ScrollPane>
    </left>

    <!-- AREA KONTEN UTAMA KANAN -->
    <center>
        <BorderPane>
            <!-- Top Header Bar -->
            <top>
                <VBox>
                    <HBox fx:id="sharedHeader" styleClass="top-header-bar" alignment="CENTER_LEFT">
                        <VBox spacing="2">
                            <Label fx:id="headerTitleLabel" text="Dashboard Kesehatan" styleClass="page-title"/>
                            <Label fx:id="headerSubtitleLabel" text="Selamat datang! Pantau dan bangun kebiasaan sehat hari ini." styleClass="page-subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox alignment="CENTER" spacing="10">
                            <Label fx:id="headerDateBadgeLabel" text="Minggu, 18 Oktober 2026" styleClass="date-badge"/>
                            <Button fx:id="btnSuara" text="Suara" styleClass="btn-secondary" onAction="#handleToggleSuara"/>
                            <Button fx:id="btnUjiAlarm" text="Uji Alarm" styleClass="btn-secondary" onAction="#handleUjiAlarm"/>
                        </HBox>
                    </HBox>

                    <!-- Banner Notifikasi Melayang (F-08 & Alerts) -->
                    <HBox fx:id="bannerNotificationBox" styleClass="notification-banner" alignment="CENTER_LEFT" visible="false" managed="false">
                        <StackPane fx:id="bannerIconSlot" minWidth="20"/>
                        <Label fx:id="bannerNotificationText" text="Pengingat Tidur" styleClass="notification-banner-text" HBox.hgrow="ALWAYS"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Tutup" styleClass="btn-outline" style="-fx-padding: 3 10; -fx-font-size: 11px;" onAction="#handleCloseBanner"/>
                    </HBox>
                </VBox>
            </top>

            <!-- Dynamic View Container -->
            <center>
                <StackPane fx:id="contentArea" style="-fx-background-color: #FBFAF6;">
                    <!-- Konten Halaman Aktif Dimuat di Sini Secara Dinamis -->
                </StackPane>
            </center>
        </BorderPane>
    </center>

</BorderPane>

        <VBox fx:id="faqSectionBox" styleClass="landing-section-white" spacing="24.0" alignment="CENTER">
            <VBox spacing="8.0" alignment="CENTER" maxWidth="760.0">
                <Label text="PUSAT INFORMASI &amp; TRANSPARANSI" styleClass="section-tag-pill"/>
                <Label text="Pertanyaan yang Sering Diajukan" styleClass="section-title-navy"/>
                <Label text="Pelajari lebih lanjut mengenai metodologi, privasi data, dan keabsahan prinsip kesehatan yang diterapkan dalam SehatHarian."
                       styleClass="section-desc-clean" textAlignment="CENTER" wrapText="true"/>
            </VBox>

            <VBox spacing="12.0" maxWidth="960.0" HBox.hgrow="ALWAYS">
                <!-- FAQ 1 -->
                <VBox styleClass="faq-item-card">
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="faq-header" onMouseClicked="#handleToggleFaq1">
                        <Label text="Apakah SehatHarian dapat digunakan secara gratis?" styleClass="faq-question-text" HBox.hgrow="ALWAYS"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblFaqArrow1" text="▼" styleClass="faq-arrow-icon"/>
                    </HBox>
                    <VBox fx:id="faqContent1" styleClass="faq-content-box">
                        <Label text="Ya! Seluruh fitur inti pencatatan kebiasaan hidrasi, tantangan mikro harian, rekomendasi adaptif, dan evaluasi mingguan dapat diakses secara gratis tanpa biaya langganan tersembunyi."
                               styleClass="faq-answer-text" wrapText="true"/>
                    </VBox>
                </VBox>

                <!-- FAQ 2 -->
                <VBox styleClass="faq-item-card">
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="faq-header" onMouseClicked="#handleToggleFaq2">
                        <Label text="Bagaimana SehatHarian mengkalibrasi tantangan agar realistis?" styleClass="faq-question-text" HBox.hgrow="ALWAYS"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblFaqArrow2" text="▶" styleClass="faq-arrow-icon"/>
                    </HBox>
                    <VBox fx:id="faqContent2" styleClass="faq-content-box" visible="false" managed="false">
                        <Label text="Pada saat awal bergabung (Onboarding), Anda mengisi waktu luang harian dan kelompok aktivitas Anda. Algoritma kami menyesuaikan target agar tidak membebani, misalnya 5-10 menit peregangan untuk pekerja kantoran dan aktivitas mobilitas aman untuk lansia."
                               styleClass="faq-answer-text" wrapText="true"/>
                    </VBox>
                </VBox>

                <!-- FAQ 3 -->
                <VBox styleClass="faq-item-card">
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="faq-header" onMouseClicked="#handleToggleFaq3">
                        <Label text="Bagaimana privasi dan kerahasiaan data rutinitas kesehatan saya?" styleClass="faq-question-text" HBox.hgrow="ALWAYS"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblFaqArrow3" text="▶" styleClass="faq-arrow-icon"/>
                    </HBox>
                    <VBox fx:id="faqContent3" styleClass="faq-content-box" visible="false" managed="false">
                        <Label text="Keamanan dan privasi Anda terjamin. Catatan aktivitas, riwayat tidur, dan informasi profil disimpan secara aman di basis data terisolasi dan tidak pernah dibagikan atau dijual ke pihak ketiga manapun."
                               styleClass="faq-answer-text" wrapText="true"/>
                    </VBox>
                </VBox>

                <!-- FAQ 4 -->
                <VBox styleClass="faq-item-card">
                    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="faq-header" onMouseClicked="#handleToggleFaq4">
                        <Label text="Apakah aplikasi ini menggantikan konsultasi dengan dokter?" styleClass="faq-question-text" HBox.hgrow="ALWAYS"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblFaqArrow4" text="▶" styleClass="faq-arrow-icon"/>
                    </HBox>
                    <VBox fx:id="faqContent4" styleClass="faq-content-box" visible="false" managed="false">
                        <Label text="Tidak. SehatHarian adalah platform pendukung gaya hidup mandiri dan pembentukan kebiasaan sehat preventif. Untuk diagnosis penyakit atau keluhan kesehatan spesifik, selalu konsultasikan secara langsung dengan dokter atau tenaga kesehatan profesional."
                               styleClass="faq-answer-text" wrapText="true"/>
                    </VBox>
                </VBox>
            </VBox>
        </VBox>


<?xml version="1.0" encoding="UTF-8"?>

<?import com.sehatharian.util.Illustrations?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import com.sehatharian.util.AdaptiveRow?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="main-content-scroll, ui2" stylesheets="@../css/styles.css, @../css/sehat-theme.css, @../css/ui2.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sehatharian.controller.RekomendasiController" minWidth="0">

    <VBox fx:id="rekomendasiRoot" spacing="18" styleClass="content-pane">

        <!-- 1. HEADER SECTION -->
        <AdaptiveRow styleClass="wellness-card" alignment="CENTER_LEFT" spacing="18">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <AdaptiveRow alignment="CENTER_LEFT" spacing="8">
                    <Label text="PILIHAN KEBIASAAN" styleClass="preference-badge-blue" wrapText="true"/>
                </AdaptiveRow>
                <Label text="Rekomendasi untuk rutinitasmu" styleClass="page-title" wrapText="true"/>
                <Label text="Pilihan aktivitas dan menu berdasarkan filter profil. Kartu latihan berupa deskripsi; sesi berpemandu belum tersedia."
                       styleClass="page-subtitle" wrapText="true"/>
            </VBox>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label fx:id="labelJumlahRekomendasi" text="0 Rekomendasi Tersedia" styleClass="sleep-table-count" wrapText="true"/>
                <Label text="Sesuai kriteria filter" styleClass="form-hint" wrapText="true"/>
            </VBox>

        </AdaptiveRow>

        <VBox spacing="8" styleClass="wellness-card">
            <Label fx:id="labelSumberData" text="Memuat katalog…" wrapText="true"/>
            <AdaptiveRow spacing="8">
                <Button text="Muat Katalog Database" styleClass="btn-outline" onAction="#handleLoadDatabase"/>
                <Button text="Pratinjau Data Contoh" styleClass="btn-outline" onAction="#handlePreviewDemo"/>
            </AdaptiveRow>
        </VBox>

        <!-- 2. KONTROL FILTER (F-02 WAKTU LUANG & F-06 KATEGORI DEMOGRAFI) -->
        <VBox styleClass="wellness-card" spacing="14">
            <AdaptiveRow alignment="CENTER_LEFT">
                <VBox spacing="1">
                    <Label text="Sesuaikan pilihan" styleClass="card-title" wrapText="true"/>
                    <Label text="Sesuaikan dengan waktu luang aktual dan rutinitas kerja Anda hari ini" styleClass="card-subtitle" wrapText="true"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Atur Ulang Filter" styleClass="btn-outline" onAction="#handleResetFilter"/>
            </AdaptiveRow>

            <!-- Tiga Dimensi Filter -->
            <AdaptiveRow spacing="14" alignment="TOP_LEFT">

                <!-- F-02: Batas Waktu Luang -->
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Ketersediaan Waktu Luang:" styleClass="form-label" wrapText="true"/>
                    <ComboBox fx:id="comboWaktuLuang" prefWidth="180" maxWidth="Infinity" onAction="#handleFilterChanged"/>
                    <Label fx:id="labelWaktuLuangInfo" text="Aktivitas dijamin ≤ 30 menit" styleClass="form-hint" wrapText="true"/>
                </VBox>

                <!-- F-06: Golongan Kesibukan -->
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Tipe Rutinitas Kerja:" styleClass="form-label" wrapText="true"/>
                    <ComboBox fx:id="comboKesibukan" prefWidth="200" maxWidth="Infinity" onAction="#handleFilterChanged"/>
                    <Label text="Dalam rumah (WFH) vs luar kantor" styleClass="form-hint" wrapText="true"/>
                </VBox>

                <!-- F-06: Golongan Usia -->
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Kelompok Usia Pengguna:" styleClass="form-label" wrapText="true"/>
                    <ComboBox fx:id="comboUsia" prefWidth="170" maxWidth="Infinity" onAction="#handleFilterChanged"/>
                    <Label text="Penyesuaian intensitas fisik" styleClass="form-hint" wrapText="true"/>
                </VBox>
            </AdaptiveRow>

            <!-- Kategori Tipe Rekomendasi (Segmented Control) -->
            <VBox spacing="6" style="-fx-padding: 8 0 0 0; -fx-border-color: #F1F5F9; -fx-border-width: 1 0 0 0;">
                <Label text="Kategori Rekomendasi:" styleClass="form-label" wrapText="true"/>
                <AdaptiveRow spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="btnTipeSemua" text="Semua" styleClass="btn-primary" onAction="#handleFilterTipeSemua"/>
                    <Button fx:id="btnTipeAktivitas" text="Aktivitas" styleClass="btn-outline" onAction="#handleFilterTipeAktivitas"/>
                    <Button fx:id="btnTipeMenu" text="Menu" styleClass="btn-outline" onAction="#handleFilterTipeMenu"/>
                    <Button fx:id="btnTipeWorkout" text="Latihan rumah" styleClass="btn-outline" onAction="#handleFilterTipeWorkout"/>
                </AdaptiveRow>
            </VBox>
        </VBox>

        <!-- 3. CONTAINER DAFTAR KARTU REKOMENDASI -->
        <VBox fx:id="cardsContainer" spacing="12">
            <!-- Kartu dinamis dimuat oleh RekomendasiController -->
        </VBox>

        <!-- 4. EMPTY STATE KETIKA FILTER TERLALU KETAT -->
        <VBox fx:id="emptyStateBox" styleClass="empty-state-box" visible="false" managed="false">
            <ImageView fx:id="emptyStateImageView" fitHeight="110" fitWidth="140" pickOnBounds="true" preserveRatio="true"/>
            <Label text="Tidak Ada Rekomendasi yang Memenuhi Kriteria Filter" styleClass="empty-state-title" wrapText="true"/>
            <Label text="Cobalah meningkatkan pilihan batas waktu luang atau ubah pilihan rutinitas kerja untuk melihat opsi rekomendasi lainnya."
                   styleClass="empty-state-subtitle" wrapText="true"/>
            <Button text="Atur ulang filter" styleClass="btn-primary" onAction="#handleResetFilter"/>
        </VBox>

    </VBox>
</ScrollPane>

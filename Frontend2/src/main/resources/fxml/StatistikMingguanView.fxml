<?xml version="1.0" encoding="UTF-8"?>

<?import com.sehatharian.util.Illustrations?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import com.sehatharian.util.AdaptiveRow?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="main-content-scroll, ui2" stylesheets="@../css/styles.css, @../css/sehat-theme.css, @../css/ui2.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sehatharian.controller.StatistikMingguanController" minWidth="0">

    <VBox fx:id="statistikRoot" spacing="18" styleClass="content-pane">

        <!-- Header Panel -->
        <AdaptiveRow styleClass="wellness-card" alignment="CENTER_LEFT" spacing="18">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <AdaptiveRow alignment="CENTER_LEFT" spacing="8">
                    <Label text="PROGRES PENCATATAN" styleClass="preference-badge-blue" wrapText="true"/>
                </AdaptiveRow>
                <Label text="Progres mingguan" styleClass="page-title" wrapText="true"/>
                <Label fx:id="labelPeriodeSubtitle" text="Data riil kebiasaan sehat 7 hari terakhir dari database MySQL" styleClass="page-subtitle" wrapText="true"/>
            </VBox>
            <AdaptiveRow spacing="10" alignment="CENTER_RIGHT">
                <Label text="Akhir Periode:" styleClass="form-label" wrapText="true"/>
                <DatePicker fx:id="datePickerAkhir" onAction="#handleUbahPeriode" prefWidth="160"/>
                <Button text="Segarkan Data" styleClass="btn-secondary" onAction="#handleSegarkan"/>
            </AdaptiveRow>

        </AdaptiveRow>

        <Label fx:id="labelCoverage" text="Memuat kelengkapan pencatatan…" wrapText="true" styleClass="card-subtitle"/>

        <!-- KARTU RINGKASAN METRIK MINGGUAN -->
        <AdaptiveRow spacing="14">
            <VBox styleClass="wellness-card" spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Rata-rata Skor Konsistensi" styleClass="card-subtitle" wrapText="true"/>
                <Label fx:id="metricSkorLabel" text="0%" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #202121;" wrapText="true"/>
                <Label text="Indikator aplikasi; bukan skor kesehatan" styleClass="form-hint" wrapText="true"/>
            </VBox>

            <VBox styleClass="wellness-card" spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Rata-rata rencana tidur" styleClass="card-subtitle" wrapText="true"/>
                <Label fx:id="metricTidurLabel" text="0.0 Jam" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #202121;" wrapText="true"/>
                <Label fx:id="metricTidurStandarLabel" text="Standar minimal: ≥ 5.0 jam" styleClass="form-hint" wrapText="true"/>
            </VBox>

            <VBox styleClass="wellness-card" spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Total Hidrasi 7 Hari" styleClass="card-subtitle" wrapText="true"/>
                <Label fx:id="metricHidrasiLabel" text="0 ml" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #202121;" wrapText="true"/>
                <Label text="Jumlah air yang tercatat" styleClass="form-hint" wrapText="true"/>
            </VBox>

            <VBox styleClass="wellness-card" spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Total Aktivitas Fisik" styleClass="card-subtitle" wrapText="true"/>
                <Label fx:id="metricAktivitasLabel" text="0 Menit" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #202121;" wrapText="true"/>
                <Label text="Durasi aktivitas yang tercatat" styleClass="form-hint" wrapText="true"/>
            </VBox>
        </AdaptiveRow>

        <!-- GRID GRAFIK JAVAFX -->
        <AdaptiveRow spacing="18">
            <!-- 1. GRAFIK KONSISTENSI KOMPOSIT -->
            <VBox styleClass="wellness-card" spacing="10" HBox.hgrow="ALWAYS" prefWidth="480">
                <Label text="Skor Konsistensi Komposit Harian (%)" styleClass="card-title" wrapText="true"/>
                <BarChart fx:id="chartKonsistensi" legendVisible="false" prefHeight="260">
                    <xAxis>
                        <CategoryAxis fx:id="axisHariKonsistensi" label="Hari"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Skor (%)" lowerBound="0" upperBound="100" autoRanging="false" tickUnit="20"/>
                    </yAxis>
                </BarChart>
            </VBox>

            <!-- 2. GRAFIK DURASI TIDUR (DENGAN GARIS STANDAR) -->
            <VBox styleClass="wellness-card" spacing="10" HBox.hgrow="ALWAYS" prefWidth="480">
                <Label text="Rencana tidur harian (jam)" styleClass="card-title" wrapText="true"/>
                <LineChart fx:id="chartTidur" legendVisible="true" prefHeight="260">
                    <xAxis>
                        <CategoryAxis fx:id="axisHariTidur" label="Hari"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Durasi (Jam)" lowerBound="0" upperBound="12" autoRanging="false" tickUnit="2"/>
                    </yAxis>
                </LineChart>
            </VBox>
        </AdaptiveRow>

        <AdaptiveRow spacing="18">
            <!-- 3. GRAFIK ASUPAN HIDRASI -->
            <VBox styleClass="wellness-card" spacing="10" HBox.hgrow="ALWAYS" prefWidth="480">
                <Label text="Asupan Hidrasi Air Putih Harian (ml)" styleClass="card-title" wrapText="true"/>
                <BarChart fx:id="chartHidrasi" legendVisible="false" prefHeight="260">
                    <xAxis>
                        <CategoryAxis fx:id="axisHariHidrasi" label="Hari"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Mililiter (ml)" lowerBound="0" upperBound="3000" autoRanging="true"/>
                    </yAxis>
                </BarChart>
            </VBox>

            <!-- 4. GRAFIK DURASI AKTIVITAS FISIK -->
            <VBox styleClass="wellness-card" spacing="10" HBox.hgrow="ALWAYS" prefWidth="480">
                <Label text="Durasi Aktivitas Fisik (Menit)" styleClass="card-title" wrapText="true"/>
                <BarChart fx:id="chartAktivitas" legendVisible="false" prefHeight="260">
                    <xAxis>
                        <CategoryAxis fx:id="axisHariAktivitas" label="Hari"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Menit" lowerBound="0" upperBound="120" autoRanging="true"/>
                    </yAxis>
                </BarChart>
            </VBox>
        </AdaptiveRow>

    </VBox>
</ScrollPane>

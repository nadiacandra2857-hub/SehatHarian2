<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sehatharian.controller.OnboardingController"
            stylesheets="@../css/styles.css"
            fitToWidth="true" fitToHeight="true"
            styleClass="onboarding-root"
            prefWidth="1120.0" prefHeight="760.0">

    <StackPane alignment="CENTER" style="-fx-padding: 30 20;">
        <VBox styleClass="onboarding-card" spacing="24.0">

            <!-- HEADER & PROGRESS BAR -->
            <VBox spacing="14.0">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="INFORMASI DASAR" styleClass="onboarding-top-badge"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <HBox spacing="8.0" alignment="CENTER_RIGHT">
                        <Label fx:id="step1Badge" text="1. Waktu Luang" styleClass="onboarding-step-indicator, active"/>
                        <Label fx:id="step2Badge" text="2. Aktivitas" styleClass="onboarding-step-indicator"/>
                        <Label fx:id="step3Badge" text="3. Kelompok Umur" styleClass="onboarding-step-indicator"/>
                    </HBox>
                </HBox>

                <!-- Progress Track Line -->
                <StackPane alignment="CENTER_LEFT" styleClass="onboarding-progress-track">
                    <StackPane fx:id="progressFillPane" styleClass="onboarding-progress-fill" prefWidth="220.0" maxWidth="660.0"/>
                </StackPane>
            </VBox>

            <!-- ================================================================= -->
            <!-- SLIDE 1: WAKTU LUANG (Maksimal 4 Jam) -->
            <!-- ================================================================= -->
            <VBox fx:id="slide1Container" spacing="18.0">
                <VBox spacing="6.0">
                    <Label text="Berapa lama waktu luang yang kamu miliki setiap hari?"
                           styleClass="onboarding-question-title" wrapText="true"/>
                    <Label text="Pilih durasi waktu luang terbesar yang realistis dapat kamu luangkan setiap hari (maksimal 4 jam)."
                           styleClass="onboarding-question-subtitle" wrapText="true"/>
                </VBox>

                <!-- Options List (1 choice only, max 4 hours) -->
                <VBox spacing="10.0">
                    <!-- Option 0: Kurang dari 1 jam -->
                    <HBox fx:id="cardWaktu0" styleClass="onboarding-option-card" spacing="14.0" alignment="CENTER_LEFT" onMouseClicked="#handlePilihWaktu0">
                        <StackPane styleClass="onboarding-option-radio">
                            <Label text="•" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </StackPane>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label text="Kurang dari 1 jam" styleClass="onboarding-option-title"/>
                            <Label text="Cocok untuk peregangan singkat atau jalan santai 15–30 menit di sela aktivitas padat." styleClass="onboarding-option-desc"/>
                        </VBox>
                        <Label text="15-45 mnt" styleClass="preference-badge-amber"/>
                    </HBox>

                    <!-- Option 1: 1 jam -->
                    <HBox fx:id="cardWaktu1" styleClass="onboarding-option-card" spacing="14.0" alignment="CENTER_LEFT" onMouseClicked="#handlePilihWaktu1">
                        <StackPane styleClass="onboarding-option-radio">
                            <Label text="•" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </StackPane>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label text="1 jam" styleClass="onboarding-option-title"/>
                            <Label text="Ideal untuk rutinitas jalan kaki harian dan latihan fisik teratur di rumah." styleClass="onboarding-option-desc"/>
                        </VBox>
                        <Label text="60 mnt" styleClass="preference-badge-green"/>
                    </HBox>

                    <!-- Option 2: 2 jam -->
                    <HBox fx:id="cardWaktu2" styleClass="onboarding-option-card" spacing="14.0" alignment="CENTER_LEFT" onMouseClicked="#handlePilihWaktu2">
                        <StackPane styleClass="onboarding-option-radio">
                            <Label text="•" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </StackPane>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label text="2 jam" styleClass="onboarding-option-title"/>
                            <Label text="Cukup leluasa untuk kombinasi olahraga kardio, persiapan makan bergizi, dan istirahat rileks." styleClass="onboarding-option-desc"/>
                        </VBox>
                        <Label text="120 mnt" styleClass="preference-badge-green"/>
                    </HBox>

                    <!-- Option 3: 3 jam -->
                    <HBox fx:id="cardWaktu3" styleClass="onboarding-option-card" spacing="14.0" alignment="CENTER_LEFT" onMouseClicked="#handlePilihWaktu3">
                        <StackPane styleClass="onboarding-option-radio">
                            <Label text="•" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </StackPane>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label text="3 jam" styleClass="onboarding-option-title"/>
                            <Label text="Waktu yang sangat baik untuk rutinitas olahraga komprehensif dan pemulihan kebugaran." styleClass="onboarding-option-desc"/>
                        </VBox>
                        <Label text="180 mnt" styleClass="preference-badge-blue"/>
                    </HBox>

                    <!-- Option 4: 4 jam (Batas Maksimal) -->
                    <HBox fx:id="cardWaktu4" styleClass="onboarding-option-card" spacing="14.0" alignment="CENTER_LEFT" onMouseClicked="#handlePilihWaktu4">
                        <StackPane styleClass="onboarding-option-radio">
                            <Label text="•" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        </StackPane>
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label text="4 jam (Batas Maksimal)" styleClass="onboarding-option-title"/>
                            <Label text="Waktu luang maksimal untuk variasi olahraga luar dan dalam ruangan tanpa mengganggu jam tidur." styleClass="onboarding-option-desc"/>
                        </VBox>
                        <Label text="240 mnt" styleClass="preference-badge-blue"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- ================================================================= -->
            <!-- SLIDE 2: AKTIVITAS YANG DILAKUKAN (OUTDOOR VS INDOOR) -->
            <!-- ================================================================= -->
            <VBox fx:id="slide2Container" spacing="18.0" visible="false" managed="false">
                <VBox spacing="6.0">
                    <Label text="Di mana kamu lebih sering melakukan aktivitas?"
                           styleClass="onboarding-question-title" wrapText="true"/>
                    <Label text="Pilih lingkungan aktivitas utama yang paling nyaman dan sering kamu lakukan sehari-hari."
                           styleClass="onboarding-question-subtitle" wrapText="true"/>
                </VBox>

                <!-- Two Distinct Choice Cards -->
                <HBox spacing="18.0" alignment="CENTER">
                    <!-- OUTDOOR CARD -->
                    <VBox fx:id="cardOutdoor" styleClass="onboarding-option-card" spacing="14.0" HBox.hgrow="ALWAYS" onMouseClicked="#handlePilihOutdoor">
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <ImageView fx:id="imgOutdoorView" fitWidth="48.0" fitHeight="48.0" preserveRatio="true"/>
                            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label text="Outdoor" styleClass="onboarding-option-title" style="-fx-font-size: 17px;"/>
                                <Label text="Aktivitas di Luar Ruangan" style="-fx-font-size: 12px; -fx-text-fill: #2E7D32; -fx-font-weight: 600;"/>
                            </VBox>
                            <StackPane styleClass="onboarding-option-radio">
                                <Label text="•" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            </StackPane>
                        </HBox>

                        <VBox spacing="6.0" style="-fx-padding: 6 0 0 0;">
                            <Label text="Contoh aktivitas yang disarankan:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <Label text="• Berjalan kaki di taman atau rute sekitar rumah" style="-fx-font-size: 12.5px; -fx-text-fill: #64748B;"/>
                            <Label text="• Jogging santai pagi atau sore hari" style="-fx-font-size: 12.5px; -fx-text-fill: #64748B;"/>
                            <Label text="• Bersepeda keliling kompleks atau jalur hijau" style="-fx-font-size: 12.5px; -fx-text-fill: #64748B;"/>
                            <Label text="• Aktivitas luar ruangan bernuansa alam lainnya" style="-fx-font-size: 12.5px; -fx-text-fill: #64748B;"/>
                        </VBox>
                    </VBox>

                    <!-- INDOOR CARD -->
                    <VBox fx:id="cardIndoor" styleClass="onboarding-option-card" spacing="14.0" HBox.hgrow="ALWAYS" onMouseClicked="#handlePilihIndoor">
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <ImageView fx:id="imgIndoorView" fitWidth="48.0" fitHeight="48.0" preserveRatio="true"/>
                            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                <Label text="Indoor" styleClass="onboarding-option-title" style="-fx-font-size: 17px;"/>
                                <Label text="Aktivitas di Dalam Ruangan" style="-fx-font-size: 12px; -fx-text-fill: #2E7D32; -fx-font-weight: 600;"/>
                            </VBox>
                            <StackPane styleClass="onboarding-option-radio">
                                <Label text="•" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            </StackPane>
                        </HBox>

                        <VBox spacing="6.0" style="-fx-padding: 6 0 0 0;">
                            <Label text="Contoh aktivitas yang disarankan:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <Label text="• Peregangan otot dan mobilitas tubuh di rumah" style="-fx-font-size: 12.5px; -fx-text-fill: #64748B;"/>
                            <Label text="• Latihan beban tubuh ringan (bodyweight workout)" style="-fx-font-size: 12.5px; -fx-text-fill: #64748B;"/>
                            <Label text="• Yoga dan latihan pernapasan rileks" style="-fx-font-size: 12.5px; -fx-text-fill: #64748B;"/>
                            <Label text="• Senam lantai atau latihan fleksibilitas lainnya" style="-fx-font-size: 12.5px; -fx-text-fill: #64748B;"/>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ================================================================= -->
            <!-- SLIDE 3: KELOMPOK UMUR (REMAJA, DEWASA, TUA / LANSIA) -->
            <!-- ================================================================= -->
            <VBox fx:id="slide3Container" spacing="18.0" visible="false" managed="false">
                <VBox spacing="6.0">
                    <Label text="Kamu termasuk kelompok umur yang mana?"
                           styleClass="onboarding-question-title" wrapText="true"/>
                    <Label text="Tingkat intensitas tantangan dan anjuran kebiasaan sehat akan disesuaikan dengan rentang usia Anda."
                           styleClass="onboarding-question-subtitle" wrapText="true"/>
                </VBox>

                <!-- Three Large, Elderly-Accessible Cards -->
                <VBox spacing="12.0">
                    <!-- Option 1: Remaja -->
                    <VBox fx:id="cardRemaja" styleClass="onboarding-option-card" spacing="6.0" onMouseClicked="#handlePilihRemaja">
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <StackPane styleClass="onboarding-option-radio">
                                <Label text="•" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            </StackPane>
                            <Label text="Remaja (15 – 24 Tahun)" styleClass="onboarding-age-title" HBox.hgrow="ALWAYS"/>
                            <Label text="Fase Pertumbuhan &amp; Energi" styleClass="preference-badge-blue"/>
                        </HBox>
                        <Label text="Fokus pada pembentukan kebiasaan harian aktif, postur tubuh baik, hidrasi cukup, dan pola tidur konsisten."
                               styleClass="onboarding-age-desc" style="-fx-padding: 0 0 0 32;"/>
                    </VBox>

                    <!-- Option 2: Dewasa -->
                    <VBox fx:id="cardDewasa" styleClass="onboarding-option-card" spacing="6.0" onMouseClicked="#handlePilihDewasa">
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <StackPane styleClass="onboarding-option-radio">
                                <Label text="•" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            </StackPane>
                            <Label text="Dewasa (25 – 59 Tahun)" styleClass="onboarding-age-title" HBox.hgrow="ALWAYS"/>
                            <Label text="Produktif &amp; Keseimbangan Kerja" styleClass="preference-badge-green"/>
                        </HBox>
                        <Label text="Fokus pada manajemen stres, pencegahan gaya hidup sedentary karena duduk bekerja, workout teratur, dan istirahat berkualitas."
                               styleClass="onboarding-age-desc" style="-fx-padding: 0 0 0 32;"/>
                    </VBox>

                    <!-- Option 3: Tua / Lansia -->
                    <VBox fx:id="cardLansia" styleClass="onboarding-option-card" spacing="6.0" onMouseClicked="#handlePilihLansia">
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <StackPane styleClass="onboarding-option-radio">
                                <Label text="•" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                            </StackPane>
                            <Label text="Tua / Lansia (60+ Tahun)" styleClass="onboarding-age-title" HBox.hgrow="ALWAYS"/>
                            <Label text="Mobilitas Aman &amp; Kebugaran Tulang" styleClass="preference-badge-amber"/>
                        </HBox>
                        <Label text="Fokus pada kelenturan sendi, keseimbangan, latihan jalan santai rendah benturan, hidrasi aman, dan tidur malam yang pulas."
                               styleClass="onboarding-age-desc" style="-fx-padding: 0 0 0 32;"/>
                    </VBox>
                </VBox>
            </VBox>

            <!-- ================================================================= -->
            <!-- ACTION BAR & VALIDATION MESSAGE -->
            <!-- ================================================================= -->
            <VBox spacing="10.0" styleClass="onboarding-action-bar">
                <!-- Validation Message Feedback -->
                <Label fx:id="validationMessageLabel" text="Silakan pilih salah satu jawaban untuk melanjutkan."
                       styleClass="auth-inline-error" style="-fx-font-size: 13px; -fx-font-weight: bold;" visible="false" managed="false"/>

                <HBox spacing="12.0" alignment="CENTER_RIGHT">
                    <!-- Tombol Kembali: Tersembunyi pada slide 1 -->
                    <Button fx:id="btnPrev" text="← Kembali" styleClass="onboarding-btn-prev" onAction="#handlePrev" visible="false" managed="false"/>

                    <HBox HBox.hgrow="ALWAYS"/>

                    <!-- Tombol Berikutnya: Aktif pada slide 1 & 2 -->
                    <Button fx:id="btnNext" text="Berikutnya →" styleClass="onboarding-btn-next" onAction="#handleNext"/>

                    <!-- Tombol Selesai: Menggantikan Berikutnya pada slide 3 -->
                    <Button fx:id="btnFinish" text="Selesai &amp; Buka Dashboard" styleClass="onboarding-btn-finish" onAction="#handleFinish" visible="false" managed="false"/>
                </HBox>
            </VBox>

        </VBox>
    </StackPane>

</ScrollPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="main-content-scroll" stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sehatharian.controller.DashboardController">

    <VBox fx:id="dashboardRoot" spacing="20" styleClass="content-pane">

        <!-- 1. GREETING HEADER & MOTIVATIONAL QUOTE (Sesuai Gambar Dashboard) -->
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="wellness-card" style="-fx-padding: 22px 24px; -fx-background-color: #1F2937;">
            <!-- Sisi Kiri: Sapaan Hangat -->
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="☀️" styleClass="greeting-sun-badge"/>
                    <VBox spacing="2">
                        <Label fx:id="heroGreetingLabel" text="Halo, Nadia!" styleClass="greeting-title"/>
                        <Label fx:id="heroDateLabel" text="Selasa, 27 Oktober 2026" styleClass="greeting-date"/>
                    </VBox>
                </HBox>
                <Label fx:id="heroQuoteLabel" text="Terus jaga kebiasaan baikmu hari ini ✨" styleClass="greeting-subtext"/>
                <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 4 0 0 0;">
                    <Button text="🎯 Kerjakan Tantangan Hari Ini" styleClass="btn-primary" onAction="#handleBukaTantangan" style="-fx-font-size: 12.5px; -fx-padding: 7 16;"/>
                    <Label fx:id="heroStatusTantanganLabel" text="0 dari 4 selesai" styleClass="card-subtitle" style="-fx-font-weight: 600;"/>
                </HBox>
            </VBox>

            <!-- Sisi Kanan: Kartu Kutipan Sehat Hijau Sesuai Gambar -->
            <HBox styleClass="dashboard-quote-card" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="“Sehat bukan tujuan akhir," styleClass="dashboard-quote-text" style="-fx-font-weight: bold;"/>
                    <Label text="tapi kebiasaan yang dibangun setiap hari.”" styleClass="dashboard-quote-text"/>
                </VBox>
                <Label text="🌿" style="-fx-font-size: 24px;"/>
            </HBox>

            <ImageView fx:id="heroImageView" fitHeight="80.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true"/>
        </HBox>

        <!-- 2. 4 KARTU STATISTIK METRIK KESEHATAN (Sesuai Gambar Dashboard) -->
        <HBox spacing="16">
            <!-- 1. Hidrasi -->
            <VBox styleClass="metric-card-hidrasi" spacing="8" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <StackPane styleClass="metric-icon-bubble-blue">
                        <Label text="💧" style="-fx-font-size: 15px;"/>
                    </StackPane>
                    <VBox spacing="1" HBox.hgrow="ALWAYS">
                        <Label text="Hidrasi" styleClass="metric-card-label"/>
                        <HBox alignment="BASELINE_LEFT" spacing="4">
                            <Label fx:id="hydrationCurrentLabel" text="6 / 8 gelas" styleClass="metric-card-val" style="-fx-text-fill: #06B6D4;"/>
                            <Label text="target" styleClass="card-subtitle" style="-fx-font-size: 11px;"/>
                        </HBox>
                    </VBox>
                    <Button text="+250ml" styleClass="btn-outline" style="-fx-padding: 3 8; -fx-font-size: 10.5px;" onAction="#handleQuickAddHydration"/>
                </HBox>
                <ProgressBar fx:id="hydrationProgressBar" progress="0.75" maxWidth="Infinity" styleClass="metric-progress-blue"/>
                <Label fx:id="hydrationStatusLabel" text="75% tercapai hari ini" styleClass="card-subtitle" style="-fx-font-size: 11px;"/>
            </VBox>

            <!-- 2. Aktivitas -->
            <VBox styleClass="metric-card-aktivitas" spacing="8" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <StackPane styleClass="metric-icon-bubble-green">
                        <Label text="🏃" style="-fx-font-size: 15px;"/>
                    </StackPane>
                    <VBox spacing="1" HBox.hgrow="ALWAYS">
                        <Label text="Aktivitas" styleClass="metric-card-label"/>
                        <HBox alignment="BASELINE_LEFT" spacing="4">
                            <Label fx:id="activityCurrentLabel" text="30 menit" styleClass="metric-card-val" style="-fx-text-fill: #22C55E;"/>
                            <Label text="aktif" styleClass="card-subtitle" style="-fx-font-size: 11px;"/>
                        </HBox>
                    </VBox>
                    <Button text="+ Catat" styleClass="btn-outline" style="-fx-padding: 3 8; -fx-font-size: 10.5px;" onAction="#handleBukaKebiasaan"/>
                </HBox>
                <ProgressBar progress="0.60" maxWidth="Infinity" styleClass="metric-progress-green"/>
                <Label fx:id="activitySummaryLabel" text="60% target harian tercapai" styleClass="card-subtitle" style="-fx-font-size: 11px;"/>
            </VBox>

            <!-- 3. Nutrisi -->
            <VBox styleClass="metric-card-nutrisi" spacing="8" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <StackPane styleClass="metric-icon-bubble-orange">
                        <Label text="🍴" style="-fx-font-size: 15px;"/>
                    </StackPane>
                    <VBox spacing="1" HBox.hgrow="ALWAYS">
                        <Label text="Nutrisi" styleClass="metric-card-label"/>
                        <HBox alignment="BASELINE_LEFT" spacing="4">
                            <Label text="2 / 3 porsi" styleClass="metric-card-val" style="-fx-text-fill: #F59E0B;"/>
                            <Label text="seimbang" styleClass="card-subtitle" style="-fx-font-size: 11px;"/>
                        </HBox>
                    </VBox>
                    <Button text="Isi Piring" styleClass="btn-outline" style="-fx-padding: 3 8; -fx-font-size: 10.5px;" onAction="#handleBukaKebiasaan"/>
                </HBox>
                <ProgressBar progress="0.67" maxWidth="Infinity" styleClass="metric-progress-orange"/>
                <Label text="67% komposisi gizi terpenuhi" styleClass="card-subtitle" style="-fx-font-size: 11px;"/>
            </VBox>

            <!-- 4. Tidur -->
            <VBox styleClass="metric-card-tidur" spacing="8" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <StackPane styleClass="metric-icon-bubble-purple">
                        <Label text="🌙" style="-fx-font-size: 15px;"/>
                    </StackPane>
                    <VBox spacing="1" HBox.hgrow="ALWAYS">
                        <Label text="Tidur" styleClass="metric-card-label"/>
                        <HBox alignment="BASELINE_LEFT" spacing="4">
                            <Label fx:id="sleepDurationLabel" text="7.5 jam" styleClass="metric-card-val" style="-fx-text-fill: #06B6D4;"/>
                            <Label text="istirahat" styleClass="card-subtitle" style="-fx-font-size: 11px;"/>
                        </HBox>
                    </VBox>
                    <Button text="Jadwal" styleClass="btn-outline" style="-fx-padding: 3 8; -fx-font-size: 10.5px;" onAction="#handleBukaTidur"/>
                </HBox>
                <ProgressBar progress="0.94" maxWidth="Infinity" styleClass="metric-progress-purple"/>
                <Label fx:id="sleepStandardBadge" text="94% (Memenuhi standar ≥ 5 jam)" styleClass="card-subtitle" style="-fx-font-size: 11px; -fx-text-fill: #06B6D4; -fx-font-weight: 600;"/>
            </VBox>
        </HBox>

        <!-- 2.5. RINGKASAN PREFERENSI ONBOARDING PENGGUNA -->
        <HBox fx:id="preferenceBannerBox" styleClass="preference-banner-card" alignment="CENTER_LEFT" spacing="14">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="PREFERENSI ADAPTIF ANDA" style="-fx-font-size: 10.5px; -fx-font-weight: bold; -fx-text-fill: #22C55E;"/>
                    <Label text="• Profil Onboarding" style="-fx-font-size: 10.5px; -fx-text-fill: #9CA3AF;"/>
                </HBox>
                <Label fx:id="prefPersonalizedNoteLabel" text="Rekomendasi dan tantangan disesuaikan dengan profil onboarding Anda:"
                       style="-fx-font-size: 12px; -fx-text-fill: #9CA3AF;"/>
            </VBox>
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <HBox spacing="4" alignment="CENTER">
                    <Label text="⏱️ Waktu Luang:" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                    <Label fx:id="prefWaktuLuangBadge" text="1 Jam" styleClass="preference-badge-green"/>
                </HBox>
                <HBox spacing="4" alignment="CENTER">
                    <Label text="🌿 Tempat:" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                    <Label fx:id="prefAktivitasBadge" text="Outdoor" styleClass="preference-badge-blue"/>
                </HBox>
                <HBox spacing="4" alignment="CENTER">
                    <Label text="👤 Kategori:" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                    <Label fx:id="prefKelompokUmurBadge" text="Dewasa" styleClass="preference-badge-amber"/>
                </HBox>
            </HBox>
        </HBox>

        <!-- 3. GRID UTAMA 2 KOLOM (Tantangan Hari Ini & Ringkasan Mingguan) Sesuai Gambar -->
        <HBox spacing="20" alignment="TOP_LEFT">

            <!-- KOLOM KIRI: TANTANGAN HARI INI -->
            <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="420.0">

                <VBox styleClass="wellness-card" spacing="14">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="2">
                            <Label text="Tantangan Hari Ini" styleClass="card-title"/>
                            <Label text="Selesaikan kebiasaan kecil untuk konsistensi harian" styleClass="card-subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Lihat Semua" styleClass="btn-outline" onAction="#handleBukaTantangan" style="-fx-font-size: 12px; -fx-padding: 5 12;"/>
                    </HBox>

                    <!-- Container Daftar Tantangan Ringkas -->
                    <VBox fx:id="challengesContainer" spacing="10">
                        <!-- Item tantangan dimuat dinamis oleh controller -->
                    </VBox>
                </VBox>

                <!-- Card Sorotan Rekomendasi Adaptif -->
                <HBox styleClass="wellness-card" spacing="16" alignment="CENTER_LEFT" style="-fx-background-color: #1F2937; -fx-border-color: rgba(34, 197, 94, 0.3);">
                    <ImageView fx:id="recHighlightImageView" fitHeight="85.0" fitWidth="105.0" pickOnBounds="true" preserveRatio="true"/>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="REKOMENDASI AKTIF" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #22C55E;"/>
                            <Label fx:id="recHighlightBadge" text="10 Menit • Relaksasi" styleClass="badge-selesai"/>
                        </HBox>
                        <Label fx:id="recHighlightTitleLabel" text="Peregangan Meja Kerja (Desk Stretch)" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #E5E7EB;"/>
                        <Label fx:id="recHighlightDescLabel" text="Luangkan 10 menit di sela aktivitas untuk meredakan ketegangan otot." styleClass="card-subtitle" wrapText="true"/>
                        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 4 0 0 0;">
                            <Button text="Eksplor Aktivitas ➔" styleClass="btn-primary" onAction="#handleBukaRekomendasi" style="-fx-font-size: 11.5px; -fx-padding: 5 12;"/>
                        </HBox>
                    </VBox>
                </HBox>

            </VBox>

            <!-- KOLOM KANAN: RINGKASAN MINGGUAN (Sesuai Gambar Dashboard) -->
            <VBox spacing="16" prefWidth="380" minWidth="320">

                <!-- Card Ringkasan Mingguan Grafik -->
                <VBox styleClass="wellness-card" spacing="14">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="2">
                            <Label text="Ringkasan Mingguan" styleClass="card-title"/>
                            <Label text="Tren konsistensi 7 hari terakhir" styleClass="card-subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Aktivitas" styleClass="badge-category" style="-fx-padding: 4 10; -fx-font-weight: bold;"/>
                    </HBox>

                    <!-- Indikator Rata-Rata Sesuai Gambar -->
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: rgba(34, 197, 94, 0.12); -fx-border-color: rgba(34, 197, 94, 0.3); -fx-border-width: 1px; -fx-border-radius: 10px; -fx-background-radius: 10px; -fx-padding: 12 16;">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Rata-rata Konsistensi" style="-fx-font-size: 11px; -fx-text-fill: #22C55E; -fx-font-weight: 600;"/>
                            <HBox alignment="BASELINE_LEFT" spacing="6">
                                <Label text="28" style="-fx-font-size: 26px; -fx-font-weight: 800; -fx-text-fill: #22C55E;"/>
                                <Label text="menit / hari" style="-fx-font-size: 12px; -fx-text-fill: #22C55E; -fx-font-weight: 600;"/>
                            </HBox>
                        </VBox>
                        <StackPane styleClass="header-avatar-circle" style="-fx-pref-width: 36px; -fx-pref-height: 36px;">
                            <Label text="↗" style="-fx-font-size: 18px; -fx-text-fill: #22C55E; -fx-font-weight: bold;"/>
                        </StackPane>
                    </HBox>

                    <!-- Mini Visual Bar Mingguan Sesuai Gambar -->
                    <HBox spacing="8" alignment="BOTTOM_CENTER" style="-fx-padding: 16 8 8 8; -fx-min-height: 110px;">
                        <VBox spacing="6" alignment="BOTTOM_CENTER" HBox.hgrow="ALWAYS">
                            <Region style="-fx-background-color: rgba(34, 197, 94, 0.25); -fx-background-radius: 6; -fx-pref-height: 45px; -fx-min-width: 24;"/>
                            <Label text="Sel" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                        </VBox>
                        <VBox spacing="6" alignment="BOTTOM_CENTER" HBox.hgrow="ALWAYS">
                            <Region style="-fx-background-color: rgba(34, 197, 94, 0.45); -fx-background-radius: 6; -fx-pref-height: 60px; -fx-min-width: 24;"/>
                            <Label text="Rab" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                        </VBox>
                        <VBox spacing="6" alignment="BOTTOM_CENTER" HBox.hgrow="ALWAYS">
                            <Region style="-fx-background-color: rgba(34, 197, 94, 0.70); -fx-background-radius: 6; -fx-pref-height: 50px; -fx-min-width: 24;"/>
                            <Label text="Kam" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                        </VBox>
                        <VBox spacing="6" alignment="BOTTOM_CENTER" HBox.hgrow="ALWAYS">
                            <Region style="-fx-background-color: #22C55E; -fx-background-radius: 6; -fx-pref-height: 75px; -fx-min-width: 24;"/>
                            <Label text="Jum" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                        </VBox>
                        <VBox spacing="6" alignment="BOTTOM_CENTER" HBox.hgrow="ALWAYS">
                            <Region style="-fx-background-color: #22C55E; -fx-background-radius: 6; -fx-pref-height: 90px; -fx-min-width: 24;"/>
                            <Label text="Sab" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #22C55E;"/>
                        </VBox>
                        <VBox spacing="6" alignment="BOTTOM_CENTER" HBox.hgrow="ALWAYS">
                            <Region style="-fx-background-color: rgba(34, 197, 94, 0.70); -fx-background-radius: 6; -fx-pref-height: 65px; -fx-min-width: 24;"/>
                            <Label text="Min" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"/>
                        </VBox>
                    </HBox>

                    <!-- Konsistensi Score Badge -->
                    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 4 0 0 0;">
                        <VBox spacing="1" HBox.hgrow="ALWAYS">
                            <Label text="Skor Konsistensi Total" styleClass="card-subtitle"/>
                            <Label fx:id="weeklyScoreBadge" text="85%" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: #22C55E;"/>
                        </VBox>
                        <Button text="Lihat Grafik ➔" styleClass="btn-primary" onAction="#handleBukaStatistik" style="-fx-font-size: 11.5px; -fx-padding: 6 12;"/>
                    </HBox>
                </VBox>

            </VBox>
        </HBox>

    </VBox>
</ScrollPane>
